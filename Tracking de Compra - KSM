/* ============ MAESTRO TALLAS SAP COMPARTIDO Y REGLAS DE CANALES ============ */
function resolverCanalUnificado(canalInicial) {
  const c = String(canalInicial || '').trim().toUpperCase();
  if (!c) return '';
  if (c.includes('PROVEEDOR')) return 'PROVEEDOR';
  if (['KAO', 'EDCA', 'MAYORISTA'].includes(c)) return 'MAYORISTA';
  if (['TIENDAS', 'WEB ADIDAS TIENDAS'].includes(c)) return 'TIENDAS';
  if (['BIG HEAD', 'EXPLORER', 'TAF', 'MARATHON', 'SNEAKERS', 'TELESHOP', 'OUTLET', 'WEB', 'WEB REEBOK MEDEPORT'].includes(c)) return 'MARATHON';
  if (c === 'MARKETING') return 'MARKETING';
  if (c === 'POP UP') return 'POP UP';
  if (c === 'SPOMA') return 'SPOMA';
  return c;
}

function resolveCanalInicialFromPO(poStr) {
  const raw = String(poStr || '').trim();
  if (!raw) return '';
  const u = raw.toUpperCase();

  // Analizar únicamente lo que va después de la temporada (después del primer guion)
  const dashIdx = u.indexOf('-');
  const afterDash = dashIdx !== -1
    ? u.slice(dashIdx + 1).trim()
    : u.replace(/^(FW|SS|S)\d{2}(Q\d)?\s*/, '').trim();
  const firstSeg = afterDash.split('-')[0].trim();

  if (afterDash.includes('ECOM MD') || afterDash.includes('WEB ADIDAS TIENDAS')) return 'WEB ADIDAS TIENDAS';

  if (/PROV[\s._-]*TAF/.test(afterDash)) return 'PROVEEDOR TAF';
  if (/PROV[\s._-]*OUTLET/.test(afterDash) || (afterDash.includes('PROVEEDOREXTRA') && afterDash.includes('CLE'))) return 'PROVEEDOR OUTLET';
  if (/PROV[\s._-]*MS/.test(afterDash) || afterDash.includes('PROVEEDOREXTRA')) return 'PROVEEDOR MS';
  if (afterDash.includes('PROVEEDOR') || afterDash.includes('PROVMINI') || firstSeg.startsWith('CLE') || afterDash.includes('PEDIDO MARCA')) return 'PROVEEDOR';

  if (firstSeg === 'BH' || afterDash.includes('BIG HEAD')) return 'BIG HEAD';
  if (firstSeg === 'EDCA' || afterDash.includes('-EDCA-') || afterDash.startsWith('EDCA-')) return 'EDCA';
  if (firstSeg === 'EXP' || firstSeg === 'EXPLORER' || firstSeg.startsWith('EXTRA_EXPLO') || afterDash.includes('EXPLORER')) return 'EXPLORER';
  if (firstSeg === 'SNK' || firstSeg === 'EXCL_SNK' || firstSeg === 'EXCLU_SNKRS' || afterDash.includes('EXCL_SNK') || afterDash.includes('SNEAKER')) return 'SNEAKERS';
  if (firstSeg === 'TSHOP' || firstSeg === 'TELESHOP' || afterDash.includes('TELESHOP')) return 'TELESHOP';
  if (firstSeg === 'POPUP' || firstSeg === 'POP UP' || afterDash.includes('POPUP') || afterDash.includes('POP UP')) return 'POP UP';
  if (firstSeg === 'SPOMA' || firstSeg.startsWith('SPOMAEVENTPACK') || afterDash.includes('-SPOMA')) return 'SPOMA';
  if (firstSeg === 'TAF' || firstSeg.startsWith('TAF_') || afterDash.includes('CLIMACOOL TAF') || afterDash.includes('-TAF-')) return 'TAF';
  if (firstSeg === 'MKT' || firstSeg.includes('15KQUITO') || firstSeg.includes('21KQUITO') || firstSeg.includes('15KQTUITO') || firstSeg.includes('MARATON15K') || afterDash.includes('-MKT-') || afterDash.includes('MKT TRENDS')) return 'MARKETING';
  if (firstSeg === 'OUT' || firstSeg === 'OUTLET' || firstSeg.startsWith('EXTRA_OUTLETS') || afterDash.includes('OUTLET')) return 'OUTLET';
  if (firstSeg === 'WEB' || firstSeg === 'EXCL_WEB' || firstSeg === 'EC EC' || firstSeg === 'MSWEB' || afterDash.includes('-WEB-') || afterDash.includes('EXCL_WEB')) return 'WEB';
  if (firstSeg === 'MAYOR' || firstSeg === 'MYR' || firstSeg === 'MAYORISTA' || firstSeg.startsWith('MAYEVENTPACK') || firstSeg === 'MAY' || afterDash.includes('MAYOR')) return 'MAYORISTA';
  if (firstSeg === 'TND' || firstSeg === 'TIENDAS' || firstSeg === 'TIEN' || firstSeg === 'TIEND' || firstSeg === 'OC QUIT' || firstSeg === 'RE_ORDER' || firstSeg === 'REORDER2' || firstSeg === 'FRA' || afterDash.includes('TIENDA') || afterDash.includes('-TND') || afterDash.includes('ECOM MUNDO') || afterDash.includes('MOQ')) return 'TIENDAS';
  if (firstSeg === 'MS' || firstSeg.startsWith('MS') || afterDash.includes('MARATHON')) return 'MARATHON';

  return 'TIENDAS';
}

function extractSeasonFromPO(poStr, fallbackSeason) {
  const u = String(poStr || '').trim().toUpperCase();
  if (!u) return fallbackSeason || S.season;
  const m4 = u.match(/^(FW\d{2}|SS\d{2})/);
  if (m4) return m4[1];
  const m3 = u.match(/^S(\d{2})/);
  if (m3) return 'SS' + m3[1];
  return fallbackSeason || S.season;
}

function buildTallaSapLookup() {
  const pairs = Array.isArray(S.sizePairs) ? S.sizePairs : [];
  const map = new Map();
  const add = (k, v) => {
    const key = String(k || '').trim().toUpperCase();
    const val = String(v || '').trim();
    if (!key || !val) return;
    if (!map.has(key)) map.set(key, []);
    const arr = map.get(key);
    if (!arr.includes(val)) arr.push(val);
  };
  for (const [tm, ts] of pairs) {
    add(tm, ts);
    const tStr = String(tm || '').trim().toUpperCase();
    if (/^-\d+$/.test(tStr)) {
      add(tStr.slice(1) + '-', ts);
    } else if (/^\d+-$/.test(tStr)) {
      add('-' + tStr.slice(0, -1), ts);
    }
  }
  return map;
}

function getTallaSapCandidates(gridVal, explicitSap, lookupMap) {
  const out = [];
  const pushUnique = v => {
    const s = String(v || '').trim();
    if (s && !out.includes(s)) out.push(s);
  };
  if (explicitSap) pushUnique(explicitSap);
  const raw = String(gridVal ?? '').trim().toUpperCase();
  if (raw) {
    const hits = lookupMap.get(raw) || [];
    hits.forEach(pushUnique);
    if (/^\d+-$/.test(raw)) {
      const alt = '-' + raw.slice(0, -1);
      (lookupMap.get(alt) || []).forEach(pushUnique);
    } else if (/^-\d+$/.test(raw)) {
      const alt = raw.slice(1) + '-';
      (lookupMap.get(alt) || []).forEach(pushUnique);
    }
    pushUnique(String(gridVal).trim());
  }
  return out;
}

/* ============ CONFIGURACIÓN DE TIENDAS Y CANALES ============ */
const TIENDAS_ADIDAS = new Set([
  'CITY', 'CONDADO', 'CAPUEL-CLUB EMELEC', 'EMELEC-TIENDA', 'CUENCA', 'JARDIN',
