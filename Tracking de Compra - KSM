async function loadPresentationTemplate(file) {
  try {
    busy('Analizando Plantilla de Presentación…');
    await tick();
    const wb = XLSX.read(await file.arrayBuffer(), { type: 'array', cellDates: true });
    // Buscar la hoja CONSOLIDADO o la primera hoja
    const targetSheetName = wb.SheetNames.find(n => norm(n).includes('consolidado')) || wb.SheetNames[0];
    const aoa = XLSX.utils.sheet_to_json(wb.Sheets[targetSheetName], { header: 1, defval: '', raw: true });
    if (!aoa.length) throw new Error('La hoja de la plantilla está vacía.');

    // Detectar dinámicamente la fila de encabezados real (donde aparece CODIGO y FOB/PVP/DETALLE)
    let headerRowIdx = -1;
    for (let i = 0; i < Math.min(15, aoa.length); i++) {
      const rowNorm = aoa[i].map(c => norm(c));
      if (rowNorm.includes('codigo') && (rowNorm.includes('fob') || rowNorm.includes('pvp') || rowNorm.includes('detalle'))) {
        headerRowIdx = i;
        break;
      }
    }
    if (headerRowIdx === -1) {
      throw new Error('No se encontró la fila de encabezados con "CODIGO" y "FOB/PVP/DETALLE" en la plantilla.');
    }

    const rawHeaders = aoa[headerRowIdx].map((h, idx) => String(h ?? '').trim() || `COL_${idx + 1}`);
    const colIdx = {};
    rawHeaders.forEach((h, idx) => {
      const nh = norm(h);
      if (!nh) return;
      if (colIdx[nh] === undefined) colIdx[nh] = idx;
    });

    const getCell = (rowArr, aliases) => {
      for (const a of aliases) {
        const idx = colIdx[norm(a)];
        if (idx !== undefined && rowArr[idx] !== undefined && rowArr[idx] !== '') {
          return rowArr[idx];
        }
      }
      return '';
    };

    const prevEntry = S.templates[sbKey()];
    const prevItems = prevEntry && prevEntry.items ? prevEntry.items : (prevEntry && !prevEntry.items ? prevEntry : {});
    const existingCatalog = tplUploadMode === 'merge' ? { ...prevItems } : {};
    const finalHeaders = (tplUploadMode === 'merge' && prevEntry && Array.isArray(prevEntry.headers) && prevEntry.headers.length >= rawHeaders.length)
      ? prevEntry.headers
      : rawHeaders;
    let parsedSkus = 0;

    for (let i = headerRowIdx + 1; i < aoa.length; i++) {
      const rowArr = aoa[i];
      const codRaw = String(getCell(rowArr, ['CODIGO', 'Código', 'SAP'])).trim();
      const cod = norm(codRaw);
      if (!cod || cod === 'origen') continue;

      const colorRaw = String(getCell(rowArr, ['COLOR PRINCIPAL', 'Color'])).trim();
      const colorClean = (colorRaw && colorRaw !== '-' && !norm(colorRaw).includes('faltacolor')) ? colorRaw : '';

      const fullRow = finalHeaders.map((hName, hIdx) => {
        const origIdx = rawHeaders.indexOf(hName);
        const val = origIdx !== -1 ? rowArr[origIdx] : rowArr[hIdx];
        if (val instanceof Date && !isNaN(val)) return fdate(val);
        return val == null ? '' : val;
      });

      existingCatalog[cod] = {
        codigo: codRaw,
        descripcion: String(getCell(rowArr, ['DETALLE', 'Descripción', 'DESCRIPCION'])).trim(),
        grupo: String(getCell(rowArr, ['GRUPO', 'Grupo'])).trim(),
        categoria: String(getCell(rowArr, ['CATEGORIA', 'Categoría', 'PRODUCT DIVISION', 'DIVISION'])).trim(),
        actividad: String(getCell(rowArr, ['ACTIVIDAD', 'Actividad'])).trim(),
        linea: String(getCell(rowArr, ['LINEA', 'Línea', 'PRODUCT LINE', 'SUBCATEGORIA'])).trim(),
        genero: String(getCell(rowArr, ['GENERO', 'Género'])).trim(),
        color: colorClean,
        fob: Number(String(getCell(rowArr, ['FOB']) || 0).replace(',', '.')) || 0,
        pvp: Number(String(getCell(rowArr, ['PVP']) || 0).replace(',', '.')) || 0,
        pvpRetail: Number(String(getCell(rowArr, ['PVP RETAIL', 'PVP retail']) || 0).replace(',', '.')) || 0,
        p4: Number(String(getCell(rowArr, ['P4']) || 0).replace(',', '.')) || 0,
        pmy: Number(String(getCell(rowArr, ['PMY']) || 0).replace(',', '.')) || 0,
        fEntrega: fdate(getCell(rowArr, ['FECHA DE ENTREGA', 'Fecha de entrega'])),
        fVenta: fdate(getCell(rowArr, ['FECHA DE VENTA', 'Fecha de venta'])),
        fullRow
      };
      parsedSkus++;
    }

    if (!parsedSkus) {
      throw new Error('No se encontraron filas con códigos válidos debajo de los encabezados.');
    }

    S.templates[sbKey()] = { headers: finalHeaders, items: existingCatalog };
    await saveMeta();

    // Aplicar inmediatamente solo a las filas existentes que NO tienen EMBARQUE asignado
    const modifiedRows = [];
    let skippedLocked = 0;
    for (const r of S.rows) {
      if (isRowLockedByEmbarque(r)) {
        skippedLocked++;
        continue;
      }
      if (applyTemplateToRow(r, existingCatalog)) {
        modifiedRows.push(r);
      }
    }

    if (modifiedRows.length) {
      busy('Sincronizando registros sin embarque…');
      await tick();
      await dbPut(modifiedRows);
    }

    await reload();
    busy();

    if (S.cloud.dirHandle && S.cloud.autoSync && S.cloud.connected) {
      pushCloudTemplateSeason(S.brand, S.season, true);
      if (modifiedRows.length) pushCloudBuySeason(S.brand, S.season, true);
    }
    modal(
      'Plantilla de Presentación Sincronizada',
      `<div class="space-y-2">
         <p>Se procesaron <b>${fn(parsedSkus)} SKUs</b> en el catálogo maestro de <b>${S.brand} ${esc(S.season)}</b> (Total catálogo: <b>${fn(Object.keys(existingCatalog).length)} SKUs</b>).</p>
         <div class="p-3 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-900 text-xs space-y-1">
           <div>✓ <b>${fn(modifiedRows.length)} líneas</b> sin embarque fueron actualizadas (descripción, FOB, precios iniciales y fechas).</div>
           <div>🔒 <b>${fn(skippedLocked)} líneas</b> que ya tienen <b>EMBARQUE</b> asignado se mantuvieron intactas sin alterar sus precios.</div>
         </div>
         <p class="text-xs text-slate-500">Cualquier compra inicial o compra extra que cargues a partir de ahora tomará automáticamente la información de esta plantilla.</p>
       </div>`
    );
  } catch(e) {
    busy();
    modal('Error al procesar Plantilla de Presentación', esc(e.message || e));
  }
}
/* ============ PARSER DE EXCEL (COMPRA INICIAL / EXTRA) ============ */
async function parseExcelFile(file, tipoCompra) {
  const wb = XLSX.read(await file.arrayBuffer(), { type: 'array', cellDates: true });
  const sheet = wb.SheetNames[0];
  const raw = XLSX.utils.sheet_to_json(wb.Sheets[sheet], { defval: '', raw: true });
  if (!raw.length) throw new Error('El archivo no contiene filas legibles.');
  const fileHeaders = Object.keys(raw[0]);
  const headerMap = {};
  
  MASTER_COLS.forEach(mCol => {
    const nCol = norm(mCol);
    const found = fileHeaders.find(h => norm(h) === nCol);
    if (found) headerMap[mCol] = found;
  });

  if (!headerMap['FOB']) {
    const fobFallback = fileHeaders.find(h => ['fob', 'costofob', 'preciofob', 'fobunitario', 'valorfob'].includes(norm(h)));
    if (fobFallback) headerMap['FOB'] = fobFallback;
  }
  
  if (!headerMap['Código'] || !headerMap['Cantidad']) {
    throw new Error('El archivo debe incluir obligatoriamente las columnas "Código" y "Cantidad".');
  }
  
  const rows = [];
  for (const o of raw) {
    const r = {};
    MASTER_COLS.forEach(col => {
      const val = headerMap[col] ? o[headerMap[col]] : '';
      if (NUM_COLS.includes(col)) {
        r[col] = Number(String(val || 0).replace(',', '.')) || 0;
      } else if (col.includes('Fecha')) {
        r[col] = fdate(val);
      } else {
        r[col] = val == null ? '' : String(val).trim();
      }
    });
    if (tipoCompra) {
      r['Detalle compra'] = tipoCompra;
    } else if (!r['Detalle compra']) {
