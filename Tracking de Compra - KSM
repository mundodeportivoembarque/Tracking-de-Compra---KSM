/* ============ VISTA CORPORATIVA: INGRESOS DE EMBARQUES POR MES Y SALDO FALTANTE ============ */
const MESES_ES = [
  'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
  'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
];

function parseYearMonth(dateStr) {
  const s = fdate(dateStr);
  if (!s) return null;
  if (/^\d{4}-\d{1,2}-\d{1,2}/.test(s)) {
    const parts = s.split('-');
    const y = parseInt(parts[0], 10);
    const m = parseInt(parts[1], 10);
    if (y > 2000 && m >= 1 && m <= 12) return { year: String(y), month: m };
  }
  return null;
}

function getRowIngresoDate(r) {
  // Prioridad absoluta: Fecha de ingreso embarque (colocada en la OC), luego Fecha de factura, luego Fecha de entrega
  return r['Fecha de ingreso embarque'] || r['Fecha de factura'] || r['Fecha de entrega'] || '';
}

function getRowPendienteDate(r) {
  // Para el saldo pendiente 10A, proyectar según Fecha de ingreso embarque (si tuviera) o Fecha de entrega / venta
  return r['Fecha de ingreso embarque'] || r['Fecha de entrega'] || r['Fecha de venta'] || '';
}

let lastCorpExportData = null;

function exportCorpExcel() {
  if (!lastCorpExportData) return modal('Sin datos', 'No hay información mensual para exportar.');
  const { brand, scopeLabel, year, rowsSummary, shipmentsDetail } = lastCorpExportData;
  const aoaSummary = [
    [`RESUMEN CORPORATIVO DE INGRESOS POR MES · ${brand.toUpperCase()} (${scopeLabel}) · AÑO ${year}`],
    [],
    ['Mes', 'Embarques del Mes', 'Unidades Ingresadas (P24)', 'FOB Ingresado ($)', 'Unidades Faltantes (10A)', 'FOB Faltante ($)', 'Total Proyectado Mes (Unid.)', '% Cumplimiento Mes'],
    ...rowsSummary.map(m => [
      m.label,
      m.shipmentsList.join(', ') || 'Sin embarques',
      m.p24Units,
      Math.round(m.p24Fob * 100) / 100,
      m.o10aUnits,
      Math.round(m.o10aFob * 100) / 100,
      m.p24Units + m.o10aUnits,
      m.pctStr
    ])
  ];
  const aoaEmbs = [
    ['Mes', 'Embarque', 'Temporada', 'Fecha Ingreso Embarque', 'Facturas', 'Líneas', 'Unidades', 'Valor FOB Neto ($)'],
    ...shipmentsDetail.map(e => [
      e.monthLabel, e.emb, e.season, e.fechaIngreso || '', e.facturas.join(', '), e.lines, e.units, Math.round(e.fob * 100) / 100
    ])
  ];
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(aoaSummary), 'Resumen_Mensual');
  XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(aoaEmbs), 'Detalle_Embarques');
  XLSX.writeFile(wb, `RESUMEN_INGRESOS_MENSUAL_${brand}_${year}.xlsx`);
}

async function vCorp() {
  const view = $('view');
  view.innerHTML = `<div class="p-8 text-center text-sm text-slate-500">Calculando consolidado mensual corporativo…</div>`;
  await tick();

  const sourceRows = S.corp.scope === 'brand'
    ? await getAllBrandRows(S.brand)
    : S.rows;

  // Detectar años disponibles en los registros
  const yearsSet = new Set();
  for (const r of sourceRows) {
    const k = st(r);
    const ym = k === 'p' ? parseYearMonth(getRowIngresoDate(r)) : parseYearMonth(getRowPendienteDate(r));
    if (ym) yearsSet.add(ym.year);
  }
  const currentYearStr = String(new Date().getFullYear());
  if (!yearsSet.size) yearsSet.add(currentYearStr);
  const availableYears = [...yearsSet].sort();
  if (!S.corp.year || !availableYears.includes(S.corp.year)) {
    S.corp.year = availableYears.includes(currentYearStr) ? currentYearStr : availableYears[availableYears.length - 1];
  }
  const selYear = S.corp.year;

  // Estructura de 12 meses + índice 0 para "Sin fecha de ingreso / entrega asignada"
  const monthsData = Array.from({ length: 13 }, (_, idx) => ({
    idx,
    label: idx === 0 ? 'Sin fecha asignada' : MESES_ES[idx - 1],
    p24Units: 0,
    p24Fob: 0,
    o10aUnits: 0,
    o10aFob: 0,
    dropUnits: 0,
    shipments: new Map() // key: embName -> { emb, season, fechaIngreso, facturas: Set, lines, units, fob }
  }));

  let totalYearBoughtUnits = 0, totalYearBoughtFob = 0;
  let totalYearP24Units = 0, totalYearP24Fob = 0;
  let totalYear10AUnits = 0, totalYear10AFob = 0;
  let totalYearDropUnits = 0, totalYearDropFob = 0;
  let p24WithoutIngresoDate = 0;

  for (const r of sourceRows) {
    const k = st(r);
    const qty = Number(r['Cantidad'] || 0);
    const fob = Number(r['Valor Neto'] || calcValorNeto(r));

    if (k === 'p') {
      const ym = parseYearMonth(getRowIngresoDate(r));
      if (ym && ym.year !== selYear) continue;
      if (!r['Fecha de ingreso embarque']) p24WithoutIngresoDate += qty;

      const mIdx = ym ? ym.month : 0;
      const bucket = monthsData[mIdx];
      bucket.p24Units += qty;
      bucket.p24Fob += fob;
      totalYearP24Units += qty;
      totalYearP24Fob += fob;
      totalYearBoughtUnits += qty;
      totalYearBoughtFob += fob;

      const embName = String(r['EMBARQUE'] || '').trim() || 'SIN NOMBRE EMBARQUE';
      if (!bucket.shipments.has(embName)) {
        bucket.shipments.set(embName, {
          emb: embName,
          season: r.season || r['Temporada'] || S.season,
          fechaIngreso: r['Fecha de ingreso embarque'] || '',
          facturas: new Set(),
          lines: 0,
          units: 0,
          fob: 0
        });
      }
      const sh = bucket.shipments.get(embName);
      sh.lines++;
      sh.units += qty;
      sh.fob += fob;
      if (r['Factura']) sh.facturas.add(String(r['Factura']).trim());
      if (!sh.fechaIngreso && r['Fecha de ingreso embarque']) sh.fechaIngreso = r['Fecha de ingreso embarque'];
    } else if (k === 'o') {
      const ym = parseYearMonth(getRowPendienteDate(r));
      if (ym && ym.year !== selYear) continue;

      const mIdx = ym ? ym.month : 0;
      const bucket = monthsData[mIdx];
      bucket.o10aUnits += qty;
      bucket.o10aFob += fob;
      totalYear10AUnits += qty;
      totalYear10AFob += fob;
      totalYearBoughtUnits += qty;
      totalYearBoughtFob += fob;
    } else if (k === 'd') {
      const ym = parseYearMonth(getRowPendienteDate(r));
      if (ym && ym.year !== selYear) continue;
      const mIdx = ym ? ym.month : 0;
      monthsData[mIdx].dropUnits += qty;
      totalYearDropUnits += qty;
      totalYearDropFob += fob;
      totalYearBoughtUnits += qty;
      totalYearBoughtFob += fob;
    }
  }

  const orderedBuckets = [
    ...monthsData.slice(1),
    ...(monthsData[0].p24Units > 0 || monthsData[0].o10aUnits > 0 ? [monthsData[0]] : [])
  ];

  const rowsSummary = orderedBuckets.map(b => {
    const embArr = [...b.shipments.values()].sort((a, z) => z.units - a.units);
    const denom = b.p24Units + b.o10aUnits;
    const pct = denom > 0 ? (b.p24Units / denom) * 100 : 0;
    return {
      ...b,
      embArr,
      shipmentsList: embArr.map(x => `${x.emb} (${fn(x.units)})`),
      pct,
      pctStr: denom > 0 ? pct.toFixed(1) + '%' : '-'
    };
  });

  const shipmentsDetail = [];
  rowsSummary.forEach(m => {
    m.embArr.forEach(e => {
      shipmentsDetail.push({
        monthLabel: m.label,
        emb: e.emb,
        season: e.season,
        fechaIngreso: e.fechaIngreso,
        facturas: [...e.facturas],
        lines: e.lines,
        units: e.units,
        fob: e.fob
