async function saveCloudDirHandle(dirHandle, autoSync = true) {
  S.cloud.dirHandle = dirHandle;
  S.cloud.dirName = dirHandle ? dirHandle.name : '';
  S.cloud.autoSync = autoSync;
  const t = db.transaction('handles', 'readwrite');
  if (dirHandle) {
    t.objectStore('handles').put({
      dirHandle,
      autoSync,
      lastSync: S.cloud.lastSync,
      filesStatus: S.cloud.filesStatus
    }, 'cloudFolder');
  } else {
    t.objectStore('handles').delete('cloudFolder');
  }
  await txDone(t);
  updateCloudBadge();
}

async function loadSavedCloudHandle() {
  try {
    const rec = await rq(db.transaction('handles').objectStore('handles').get('cloudFolder'));
    if (rec && rec.dirHandle) {
      S.cloud.dirHandle = rec.dirHandle;
      S.cloud.dirName = rec.dirHandle.name || 'Carpeta OneDrive';
      S.cloud.autoSync = rec.autoSync !== false;
      S.cloud.lastSync = rec.lastSync || '';
      S.cloud.filesStatus = rec.filesStatus || {};
      const perm = await rec.dirHandle.queryPermission({ mode: 'readwrite' });
      S.cloud.connected = (perm === 'granted');
    }
  } catch (e) {}
  updateCloudBadge();
}

async function ensureCloudPermission(requestIfNeeded = true) {
  if (!S.cloud.dirHandle) return false;
  let perm = await S.cloud.dirHandle.queryPermission({ mode: 'readwrite' });
  if (perm !== 'granted' && requestIfNeeded) {
    perm = await S.cloud.dirHandle.requestPermission({ mode: 'readwrite' });
  }
  S.cloud.connected = (perm === 'granted');
  updateCloudBadge();
  return S.cloud.connected;
}

async function compressJsonString(jsonStr) {
  if (typeof CompressionStream !== 'undefined') {
    const stream = new Blob([jsonStr]).stream().pipeThrough(new CompressionStream('gzip'));
    return await new Response(stream).arrayBuffer();
  }
  return new TextEncoder().encode(jsonStr).buffer;
}

async function decompressToJsonString(arrayBuffer) {
  const bytes = new Uint8Array(arrayBuffer);
  if (bytes.length >= 2 && bytes[0] === 0x1f && bytes[1] === 0x8b && typeof DecompressionStream !== 'undefined') {
    const stream = new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'));
    return await new Response(stream).text();
  }
  return new TextDecoder().decode(bytes);
}

async function writeCloudFile(fileName, dataBufferOrStr) {
  const fileHandle = await S.cloud.dirHandle.getFileHandle(fileName, { create: true });
  const writable = await fileHandle.createWritable();
  await writable.write(dataBufferOrStr);
  await writable.close();
}

async function readCloudFile(fileName) {
  const fileHandle = await S.cloud.dirHandle.getFileHandle(fileName, { create: false });
  return await fileHandle.getFile();
}

