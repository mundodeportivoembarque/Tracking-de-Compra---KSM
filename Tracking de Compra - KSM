// Sincroniza TODAS las marcas/temporadas hacia archivos separados en la carpeta OneDrive
async function pushAllSeparatedToCloud(silent = false) {
  if (!S.cloud.dirHandle) return false;
  const okPerm = await ensureCloudPermission(!silent);
  if (!okPerm) return false;

  try {
    if (!silent) busy('Exportando archivos separados por temporada a OneDrive…');
    await tick();
    await pushCloudConfig();

    const savedFiles = [];
    for (const b of Object.keys(S.seasons)) {
      for (const s of S.seasons[b]) {
        const key = `${b}|${s}`;
        const seasonRows = await dbSeason(key);
        if (seasonRows.length > 0) {
          await pushCloudBuySeason(b, s, true);
          savedFiles.push(`${buyFileName(b, s)} (${fn(seasonRows.length)} filas)`);
        }
        const tplObj = getTplData(key);
        if (Object.keys(tplObj.items).length > 0) {
          await pushCloudTemplateSeason(b, s, true);
          savedFiles.push(`${tplFileName(b, s)} (${fn(Object.keys(tplObj.items).length)} SKUs)`);
        }
      }
    }

    if (!silent) {
      busy();
      modal(
        'Carpeta OneDrive Sincronizada',
        `<div class="space-y-2">
           <p>Se guardaron los archivos independientes en la carpeta <b>${esc(S.cloud.dirName)}</b>:</p>
           <div class="p-3 rounded-lg bg-sky-50 border border-sky-200 text-sky-950 text-xs space-y-1 max-h-52 overflow-y-auto">
             <div class="font-semibold">• ${cfgFileName()} (Marcas, temporadas y logos)</div>
             ${savedFiles.map(f => `<div>• ${esc(f)}</div>`).join('') || '<div class="text-slate-500">Sin datos cargados aún.</div>'}
           </div>
         </div>`
      );
    }
    return true;
  } catch (e) {
    if (!silent) {
      busy();
      modal('Error al sincronizar carpeta', esc(e.message || e));
    }
    return false;
  }
}

// Lee y restaura archivos desde la carpeta OneDrive (permite cargar solo la temporada actual o toda la carpeta)
async function pullFromCloudFolder(onlyActiveSeason = false, silent = false) {
  if (!S.cloud.dirHandle) return;
  const okPerm = await ensureCloudPermission(!silent);
  if (!okPerm) return;
  try {
    if (!silent) {
      busy('Leyendo archivos de la carpeta OneDrive / SharePoint…');
      await tick();
    }
    // 1. Leer configuración (marcas, temporadas y logos) si existe
    try {
      const cfgFile = await readCloudFile(cfgFileName());
      const cfgData = JSON.parse(await cfgFile.text());
      if (cfgData.seasons) S.seasons = cfgData.seasons;
      if (cfgData.logos) S.logos = { ...S.logos, ...cfgData.logos };
      if (Array.isArray(cfgData.sizePairs)) S.sizePairs = cfgData.sizePairs;
      await saveMeta();
    } catch (e) {}
    // Listar archivos reales en la carpeta
    const entries = [];
    for await (const [name, handle] of S.cloud.dirHandle.entries()) {
      if (handle.kind === 'file' && (name.startsWith('Compra_') || name.startsWith('Plantilla_')) && name.endsWith('.json.gz')) {
        entries.push({ name, handle });
      }
    }
    if (!entries.length) {
      if (!silent) {
        busy();
        return modal(
          'Carpeta sin archivos de tracking',
          `No se encontraron archivos <code>Compra_...json.gz</code> ni <code>Plantilla_...json.gz</code> dentro de <b>${esc(S.cloud.dirName)}</b>.<br><br>
          Si es la primera vez que vinculas esta carpeta, haz clic en <b>"Guardar toda la base en carpeta"</b>.`
        );
      }
      await reload();
      return;
    }
    const targetBuy = buyFileName(S.brand, S.season);
    const targetTpl = tplFileName(S.brand, S.season);
    const toLoad = onlyActiveSeason
      ? entries.filter(e => e.name === targetBuy || e.name === targetTpl)
      : entries;
    if (!toLoad.length) {
      if (!silent) {
        busy();
        return modal('Sin archivos para esta temporada', `No existen archivos guardados para <b>${S.brand} ${esc(S.season)}</b> en la carpeta.`);
      }
      await reload();
      return;
    }
    let loadedBuyCount = 0;
    let loadedTplCount = 0;
    for (const item of toLoad) {
      if (!silent) {
        busy(`Descargando ${item.name}…`);
        await tick();
      }
      const file = await item.handle.getFile();
      const buf = await file.arrayBuffer();
      const jsonStr = await decompressToJsonString(buf);
      const data = JSON.parse(jsonStr);
      if (item.name.startsWith('Compra_') && Array.isArray(data.rows)) {
        const b = data.brand || S.brand;
        const s = data.season || S.season;
        if (!S.seasons[b]) S.seasons[b] = [];
        if (!S.seasons[b].includes(s)) S.seasons[b].push(s);
        const key = `${b}|${s}`;
        await dbDelSeason(key);
        const cleanRows = data.rows.map(r => {
          const row = { ...r, brand: b, season: s, sb: key };
          if (row['FOB'] === undefined) row['FOB'] = 0;
          row['Valor Neto'] = calcValorNeto(row);
          if (!row['Detalle compra'] || !String(row['Detalle compra']).trim()) row['Detalle compra'] = 'COMPRA CANAL';
          return row;
        });
        await dbAdd(cleanRows);
        loadedBuyCount += cleanRows.length;
        S.cloud.filesStatus[item.name] = { rows: cleanRows.length, kb: Math.round(buf.byteLength / 1024), time: new Date().toLocaleTimeString('es-EC', { hour: '2-digit', minute: '2-digit' }) };
      } else if (item.name.startsWith('Plantilla_') && data.template) {
        const b = data.brand || S.brand;
        const s = data.season || S.season;
        if (!S.seasons[b]) S.seasons[b] = [];
        if (!S.seasons[b].includes(s)) S.seasons[b].push(s);
        const key = `${b}|${s}`;
        S.templates[key] = data.template;
        loadedTplCount++;
        S.cloud.filesStatus[item.name] = { skus: Object.keys(data.template.items || data.template).length, kb: Math.round(buf.byteLength / 1024), time: new Date().toLocaleTimeString('es-EC', { hour: '2-digit', minute: '2-digit' }) };
      }
    }
    await saveMeta();
    S.cloud.lastSync = new Date().toLocaleTimeString('es-EC', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    await saveCloudDirHandle(S.cloud.dirHandle, S.cloud.autoSync);
    await reload();
    if (!silent) {
      busy();
      modal(
        'Sincronización desde OneDrive Completada',
        `<div class="space-y-2">
           <p>Se actualizaron los datos locales desde la carpeta <b>${esc(S.cloud.dirName)}</b>:</p>
           <div class="p-3 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-950 text-xs space-y-1">
             <div>• <b>Registros de compra cargados:</b> ${fn(loadedBuyCount)} filas</div>
             <div>• <b>Plantillas de presentación cargadas:</b> ${fn(loadedTplCount)} archivo(s)</div>
           </div>
         </div>`
      );
    }
  } catch (e) {
    if (!silent) {
      busy();
      modal('Error al leer carpeta OneDrive', esc(e.message || e));
    }
  }
}

async function linkCloudFolder() {
  if (!window.showDirectoryPicker) {
    return modal('Navegador no compatible', 'Tu navegador no soporta selección de carpetas. Usa Google Chrome o Microsoft Edge actualizado.');
  }
  try {
    const dirHandle = await window.showDirectoryPicker({ mode: 'readwrite' });
    await saveCloudDirHandle(dirHandle, true);
    S.cloud.connected = true;
    updateCloudBadge();

    // Revisar si la carpeta ya tiene archivos guardados previamente
    let hasExistingFiles = false;
    for await (const [name, handle] of dirHandle.entries()) {
      if (handle.kind === 'file' && (name.startsWith('Compra_') || name.startsWith('Plantilla_'))) {
        hasExistingFiles = true;
        break;
      }
    }

    if (hasExistingFiles) {
      const choice = await modal(
        `Carpeta vinculada: ${esc(dirHandle.name)}`,
        `<p>Esta carpeta de OneDrive ya contiene archivos de <b>Compras</b> y/o <b>Plantillas</b> guardados previamente.</p>
         <p class="text-xs text-slate-600 mt-1">¿Qué deseas hacer ahora?</p>`,
        [['Guardar mis datos actuales en la carpeta', 'push'], ['Cargar datos desde la carpeta a mi navegador', 'pull', 1]]
      );
      if (choice === 'pull') {
        await pullFromCloudFolder(false);
      } else if (choice === 'push') {
        await pushAllSeparatedToCloud(false);
      }
    } else {
      await pushAllSeparatedToCloud(false);
    }
  } catch (e) {
    if (e && e.name !== 'AbortError') {
      modal('No se pudo vincular la carpeta', esc(e.message || e));
    }
  }
}

