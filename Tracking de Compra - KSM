        const col = norm(r['Color']);
        const tal = normTalla(r['Talla']);
        const talM = normTalla(r['Talla marca']);
        if (tal) {
          pushIdx(seasonExactIndex, `${temp}|${cod}|${col}|${tal}`, r);
          pushIdx(seasonSkuTalIndex, `${temp}|${cod}|${tal}`, r);
          pushIdx(exactIndex, `${cod}|${col}|${tal}`, r);
          pushIdx(skuTallaIndex, `${cod}|${tal}`, r);
        }
        if (talM) {
          pushIdx(seasonExactTalMIndex, `${temp}|${cod}|${col}|${talM}`, r);
          pushIdx(exactTalMIndex, `${cod}|${col}|${talM}`, r);
          pushIdx(seasonSkuTalMIndex, `${temp}|${cod}|${talM}`, r);
          pushIdx(skuTalMIndex, `${cod}|${talM}`, r);
        }
      }
    });
    const changed = new Set();
    const added = [];
    let matchedUnits = 0;
    let matchedLines = 0;
    const perSeasonUnits = {};
    const unmatched = [];
    for (const o of raw) {
      const temp = norm(getRowVal(o, ['Temporada', 'Season']));
      const cod = norm(getRowVal(o, ['Código', 'Codigo', 'SAP']));
      const col = norm(getRowVal(o, ['Color']));
      const tal = normTalla(getRowVal(o, ['Talla']));
      const talM = normTalla(getRowVal(o, ['Talla marca', 'Talla Marca', 'TALLA MARCA'])) || tal;
      const qty = Number(String(getRowVal(o, ['Cantidad', 'QTY']) || 0).replace(',', '.')) || 0;
      const fact = String(getRowVal(o, ['Factura', 'No FACTURA', 'No FACTURA '])).trim();
      const embFinal = String(getRowVal(o, ['EMBARQUE', 'Embarque', 'Nº de embarque', 'EMBARQUES'])).trim();
      const fFact = fdate(getRowVal(o, ['Fecha de factura']));
      const fIngEmb = fdate(getRowVal(o, ['Fecha de ingreso embarque', 'Fecha ingreso embarque', 'FECHA DE INGRESO EMBARQUE', 'FECHA INGRESO EMBARQUE', 'Fecha Ingreso', 'Fecha estimada ingreso', 'Fecha Arribo']));
      const refFinal = String(getRowVal(o, ['Referencia compra', 'CANAL'])).trim();
      if (!cod || qty <= 0) continue;
      const pool = mergePools(
        (temp && tal) ? seasonExactIndex.get(`${temp}|${cod}|${col}|${tal}`) : null,
        tal ? exactIndex.get(`${cod}|${col}|${tal}`) : null,
        (temp && tal) ? seasonSkuTalIndex.get(`${temp}|${cod}|${tal}`) : null,
        tal ? skuTallaIndex.get(`${cod}|${tal}`) : null,
        (temp && talM) ? seasonExactTalMIndex.get(`${temp}|${cod}|${col}|${talM}`) : null,
        talM ? exactTalMIndex.get(`${cod}|${col}|${talM}`) : null,
        (temp && talM) ? seasonSkuTalMIndex.get(`${temp}|${cod}|${talM}`) : null,
        talM ? skuTalMIndex.get(`${cod}|${talM}`) : null,
        (temp && talM) ? seasonExactIndex.get(`${temp}|${cod}|${col}|${talM}`) : null,
        talM ? exactIndex.get(`${cod}|${col}|${talM}`) : null
      );
      if (!pool.length || !pool.some(r => r['Cantidad'] > 0)) {
        unmatched.push({ cod: getRowVal(o, ['Código', 'Codigo', 'SAP']), col: o['Color'], tal: o['Talla'], qty });
        continue;
      }
      let rem = qty;
      for (let i = 0; i < pool.length && rem > 0; i++) {
        const baseRow = pool[i];
        if (baseRow['Cantidad'] <= 0 || baseRow['Etapa'].startsWith('P24')) continue;
        const rowSeason = baseRow.season || S.season;
        if (baseRow['Cantidad'] <= rem) {
          const take = baseRow['Cantidad'];
          rem -= take;
          matchedUnits += take;
          perSeasonUnits[rowSeason] = (perSeasonUnits[rowSeason] || 0) + take;
          baseRow['Etapa'] = EP;
          if (fact) baseRow['Factura'] = fact;
          if (fFact) baseRow['Fecha de factura'] = fFact;
          if (fIngEmb) baseRow['Fecha de ingreso embarque'] = fIngEmb;
          if (embFinal) baseRow['EMBARQUE'] = embFinal;
          if (refFinal && !baseRow['Referencia compra']) baseRow['Referencia compra'] = refFinal;
          baseRow['Valor Neto'] = calcValorNeto(baseRow);
          changed.add(baseRow);
        } else {
          const facturada = { ...baseRow };
          delete facturada.id;
          facturada['Cantidad'] = rem;
          facturada['Etapa'] = EP;
          if (fact) facturada['Factura'] = fact;
          if (fFact) facturada['Fecha de factura'] = fFact;
          if (fIngEmb) facturada['Fecha de ingreso embarque'] = fIngEmb;
          if (embFinal) facturada['EMBARQUE'] = embFinal;
          if (refFinal && !facturada['Referencia compra']) facturada['Referencia compra'] = refFinal;
          facturada['Valor Neto'] = calcValorNeto(facturada);

          baseRow['Cantidad'] -= rem;
          baseRow['Valor Neto'] = calcValorNeto(baseRow);
          matchedUnits += rem;
          perSeasonUnits[rowSeason] = (perSeasonUnits[rowSeason] || 0) + rem;
          rem = 0;
          changed.add(baseRow);
          added.push(facturada);
        }
      }
      matchedLines++;
    }
    busy();
    const breakdown = Object.entries(perSeasonUnits)
      .map(([sName, u]) => `<span class="inline-block bg-slate-100 border px-2 py-0.5 rounded text-xs font-semibold mr-1.5">${esc(sName)}: ${fn(u)} unid.</span>`)
      .join('');
    const ch = await modal(
      'Confirmar cruce preliminar',
      `<p>Se descontaron con éxito <b>${fn(matchedUnits)} unidades</b> en ${fn(matchedLines)} líneas que pasan a <b>P24</b>:</p>
       <div class="my-2">${breakdown || '<span class="text-xs text-slate-400">Sin unidades cruzadas</span>'}</div>
       <p class="text-xs text-slate-500 mt-1">El saldo 10A ha quedado liberado en sus respectivas temporadas.</p>
       ${unmatched.length ? `<p class="text-amber-600 mt-2 text-xs"><b>${unmatched.length} filas</b> no encontraron saldo disponible en ninguna temporada de ${S.brand}.</p>` : ''}`,
      [['Cancelar', 'c'], ['Aplicar a la base', 'ok', 1]]
    );
    if (ch !== 'ok') return;
    busy('Actualizando base de datos…');
    await tick();
    await dbPut([...changed]);
    if (added.length) await dbAdd(added);
    await reload();
    busy();
        if (S.cloud.dirHandle && S.cloud.autoSync && S.cloud.connected) {
      const affectedSeasons = new Set([S.season, ...Object.keys(perSeasonUnits)]);
      for (const sName of affectedSeasons) {
        pushCloudBuySeason(S.brand, sName, true);
      }
    }
    modal('OC Preliminar Cargada', `Se pasaron ${fn(matchedUnits)} unidades a <b>P24</b>.`);
  } catch(e) {
    busy();
    modal('Error en cruce preliminar', esc(e.message || e));
  }
}
/* ============ 4B. CRUCE OC FINAL DE PRODUCTO (REEMPLAZA FOB CON FOB MARCA + DETECCIÓN DE CAMBIO DE PRECIO) ============ */
async function loadOcFinalProducto(file) {
  try {
    busy('Leyendo OC final de Producto en temporadas de ' + S.brand + '…');
    await tick();
    const wb = XLSX.read(await file.arrayBuffer(), { type: 'array', cellDates: true });
    const targetSheet = wb.Sheets['Hoja1'] ? 'Hoja1' : (wb.Sheets['OC'] ? 'OC' : wb.SheetNames[0]);
    const raw = XLSX.utils.sheet_to_json(wb.Sheets[targetSheet], { defval: '', raw: true });
    if (!raw.length) throw new Error('No se encontraron filas en la hoja de OC de Producto.');
    const fileBatches = new Set();
    const fileInvoices = new Set();
    for (const o of raw) {
      const fact = norm(getRowVal(o, ['Factura', 'No FACTURA', 'No FACTURA ']));
      const emb = norm(getRowVal(o, ['EMBARQUE', 'Embarque', 'Nº de embarque', 'EMBARQUES']));
      if (emb || fact) fileBatches.add(`${emb}|${fact}`);
      if (fact) fileInvoices.add(fact);
    }
    const allBrandRows = await getAllBrandRows(S.brand);
    const changed = new Set();
    allBrandRows.forEach(r => {
      if (st(r) === 'p') {
        const rEmb = norm(r['EMBARQUE']);
        const rFact = norm(r['Factura']);
        if (fileBatches.has(`${rEmb}|${rFact}`) || (!rEmb && rFact && fileInvoices.has(rFact))) {
          if (r['Canal Final'] || r['PVP Final'] || r['P4 Final'] || r['PMY Final']) {
            r['Canal Final'] = '';
            r['PVP Final'] = 0;
            r['P4 Final'] = 0;
            r['PMY Final'] = 0;
            changed.add(r);
          }
        }
      }
    });
    const p24SeasonChanExact = new Map();
    const p24ChanExact = new Map();
    const p24SeasonExact = new Map();
    const p24ExactIndex = new Map();
    const p24SeasonFactChan = new Map();
    const p24FactChan = new Map();
    const p24SeasonFact = new Map();
    const p24FactIndex = new Map();
    const p24SkuTalIndex = new Map();
    const p24SkuTalFactIndex = new Map();
    const p24FallbackIndex = new Map();
    const p24ExactTalMIndex = new Map();
    const p24FactTalMIndex = new Map();
    const p24SkuTalMFactIndex = new Map();
    const p24FallbackTalMIndex = new Map();
    const pushIdx = (map, k, row) => {
      if (!map.has(k)) map.set(k, []);
      map.get(k).push(row);
    };
    allBrandRows.forEach(r => {
      if (st(r) === 'p' && !r['Canal Final']) {
        const temp = norm(r.season || r['Temporada']);
        const cod = norm(r['Código']);
        const col = norm(r['Color']);
        const tal = normTalla(r['Talla']);
        const talM = normTalla(r['Talla marca']);
        const emb = norm(r['EMBARQUE']);
        const fact = norm(r['Factura']);
        const cIni = norm(r['Canal Inicial'] || resolverCanalInicial(r['Referencia compra'], S.brand));
        if (tal) {
          if (cIni) {
            pushIdx(p24SeasonChanExact, `${temp}|${cod}|${col}|${tal}|${emb}|${fact}|${cIni}`, r);
            pushIdx(p24ChanExact, `${cod}|${col}|${tal}|${emb}|${fact}|${cIni}`, r);
            if (fact) {
              pushIdx(p24SeasonFactChan, `${temp}|${cod}|${col}|${tal}|${fact}|${cIni}`, r);
              pushIdx(p24FactChan, `${cod}|${col}|${tal}|${fact}|${cIni}`, r);
            }
          }
          pushIdx(p24SeasonExact, `${temp}|${cod}|${col}|${tal}|${emb}|${fact}`, r);
          pushIdx(p24ExactIndex, `${cod}|${col}|${tal}|${emb}|${fact}`, r);
          if (fact) {
            pushIdx(p24SeasonFact, `${temp}|${cod}|${col}|${tal}|${fact}`, r);
            pushIdx(p24FactIndex, `${cod}|${col}|${tal}|${fact}`, r);
            pushIdx(p24SkuTalFactIndex, `${cod}|${tal}|${fact}`, r);
          }
          pushIdx(p24SkuTalIndex, `${cod}|${tal}|${emb}|${fact}`, r);
          pushIdx(p24FallbackIndex, `${cod}|${col}|${tal}`, r);
        }
        if (talM) {
          pushIdx(p24ExactTalMIndex, `${cod}|${col}|${talM}|${emb}|${fact}`, r);
          if (fact) {
            pushIdx(p24FactTalMIndex, `${cod}|${col}|${talM}|${fact}`, r);
            pushIdx(p24SkuTalMFactIndex, `${cod}|${talM}|${fact}`, r);
          }
          pushIdx(p24FallbackTalMIndex, `${cod}|${col}|${talM}`, r);
        }
      }
    });
    const added = [];
    let updatedUnits = 0;
    let updatedLines = 0;
    let fobUpdatedCount = 0;
    const perSeasonUnits = {};
    const unmatched = [];
    const priceChangedSkus = new Set();
    let priceChangedUnits = 0;

    for (const o of raw) {
      const temp = norm(getRowVal(o, ['Temporada', 'Season']));
      const cod = norm(getRowVal(o, ['Código', 'Codigo', 'SAP']));
      const col = norm(getRowVal(o, ['Color']));
      const tal = normTalla(getRowVal(o, ['Talla']));
      const talM = normTalla(getRowVal(o, ['Talla marca', 'Talla Marca', 'TALLA MARCA'])) || tal;
      const qty = Number(String(getRowVal(o, ['Cantidad', 'QTY', 'LPN DETAIL SIZE VALUE']) || 0).replace(',', '.')) || 0;
      const fact = norm(getRowVal(o, ['Factura', 'No FACTURA', 'No FACTURA ']));
      const embRaw = String(getRowVal(o, ['EMBARQUE', 'Embarque', 'Nº de embarque', 'EMBARQUES'])).trim();
      const emb = norm(embRaw);
      const fFact = fdate(getRowVal(o, ['Fecha de factura']));
      const fIngEmb = fdate(getRowVal(o, ['Fecha de ingreso embarque', 'Fecha ingreso embarque', 'FECHA DE INGRESO EMBARQUE', 'FECHA INGRESO EMBARQUE', 'Fecha Ingreso', 'Fecha estimada ingreso', 'Fecha Arribo']));
      const cIniRaw = getRowVal(o, ['Canal Inicial', 'CANAL INICIAL', 'Referencia compra', 'CANAL']);
      const cIni = norm(normalizarCanal(cIniRaw));
      const cFinalRaw = getRowVal(o, ['CANAL FINAL', 'CANAL FINAL ', 'CANAL_FINAL', 'Canal Final', 'CANAL']);
      const cFinal = normalizarCanal(cFinalRaw);
      const parsePrice = v => Number(String(v ?? '').replace(/[^0-9.,-]/g, '').replace(',', '.')) || 0;
      const fobMarca = parsePrice(getRowVal(o, ['FOB MARCA', 'FOB Marca', 'FOB_MARCA', 'FOB FINAL', 'FOB Final', 'FOB.1']));
      const pvpFin = parsePrice(getRowVal(o, ['PVP final', 'PVP FINAL', 'PVP Final', 'PVP.1', 'PVP_FINAL']));
      const p4Fin = parsePrice(getRowVal(o, ['P4 final', 'P4 FINAL', 'P4 Final', 'P4.1', 'P4_FINAL']));
      const pmyFin = parsePrice(getRowVal(o, ['PMY final', 'PMY FINAL', 'PMY Final', 'PMY.1', 'PMY_FINAL']));
      if (!cod || qty <= 0) continue;
      const rawPool = mergePools(
        (temp && cIni && tal) ? p24SeasonChanExact.get(`${temp}|${cod}|${col}|${tal}|${emb}|${fact}|${cIni}`) : null,
        (cIni && tal) ? p24ChanExact.get(`${cod}|${col}|${tal}|${emb}|${fact}|${cIni}`) : null,
        (temp && tal) ? p24SeasonExact.get(`${temp}|${cod}|${col}|${tal}|${emb}|${fact}`) : null,
        tal ? p24ExactIndex.get(`${cod}|${col}|${tal}|${emb}|${fact}`) : null,
        (temp && fact && cIni && tal) ? p24SeasonFactChan.get(`${temp}|${cod}|${col}|${tal}|${fact}|${cIni}`) : null,
        (fact && cIni && tal) ? p24FactChan.get(`${cod}|${col}|${tal}|${fact}|${cIni}`) : null,
        (temp && fact && tal) ? p24SeasonFact.get(`${temp}|${cod}|${col}|${tal}|${fact}`) : null,
        (fact && tal) ? p24FactIndex.get(`${cod}|${col}|${tal}|${fact}`) : null,
        talM ? p24ExactTalMIndex.get(`${cod}|${col}|${talM}|${emb}|${fact}`) : null,
        (fact && talM) ? p24FactTalMIndex.get(`${cod}|${col}|${talM}|${fact}`) : null,
        (talM && talM !== tal) ? p24ExactIndex.get(`${cod}|${col}|${talM}|${emb}|${fact}`) : null,
        (fact && talM && talM !== tal) ? p24FactIndex.get(`${cod}|${col}|${talM}|${fact}`) : null,
        tal ? p24SkuTalIndex.get(`${cod}|${tal}|${emb}|${fact}`) : null,
        (fact && tal) ? p24SkuTalFactIndex.get(`${cod}|${tal}|${fact}`) : null,
        (fact && talM) ? p24SkuTalMFactIndex.get(`${cod}|${talM}|${fact}`) : null,
        tal ? p24FallbackIndex.get(`${cod}|${col}|${tal}`) : null,
        talM ? p24FallbackTalMIndex.get(`${cod}|${col}|${talM}`) : null
      );
      const pool = rawPool.filter(r => {
        if (r['Cantidad'] <= 0 || r['Canal Final']) return false;
        const rEmb = norm(r['EMBARQUE']);
        if (emb && rEmb && rEmb !== emb) return false;
        return true;
      });
      if (!pool.length) {
        unmatched.push({ cod: getRowVal(o, ['Código', 'Codigo', 'SAP']), col: o['Color'], tal: o['Talla'], qty });
        continue;
      }
      let rem = qty;
      for (let i = 0; i < pool.length && rem > 0; i++) {
        const baseRow = pool[i];
        if (baseRow['Cantidad'] <= 0 || baseRow['Canal Final']) continue;
        const rowSeason = baseRow.season || S.season;
        if (baseRow['Cantidad'] <= rem) {
