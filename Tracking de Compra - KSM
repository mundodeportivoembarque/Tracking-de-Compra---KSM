async function assignPtsToForwarder(ptsFile) {
  try {
    busy(`Leyendo listado de PTs de COMEX y buscando líneas FORWARDER en ${S.brand}…`);
    await tick();
    const ptsMap = await parsePtsExcelMap(ptsFile);
    if (!ptsMap.size) {
      throw new Error('No se encontraron números de PT válidos en el archivo de COMEX.');
    }
    const detectedEmbs = [...new Set(ptsMap.values())];
    const defaultEmbName = detectedEmbs[0] || '';

    const allBrandRows = await getAllBrandRows(S.brand);
    const matchingRows = allBrandRows.filter(r => {
      if (st(r) !== 'p') return false;
      const ptVal = normalizePtId(r['Delivery']);
      if (!ptVal || !ptsMap.has(ptVal)) return false;
      const curEmb = String(r['EMBARQUE'] || '').trim().toUpperCase();
      return !curEmb || curEmb === 'FORWARDER';
    });

    busy();
    if (!matchingRows.length) {
      return modal(
        'Sin líneas FORWARDER coincidentes',
        `Se leyeron <b>${fn(ptsMap.size)} PTs</b> (Embarque: <b>${esc(detectedEmbs.join(', '))}</b>), pero no se encontraron registros en estado <b>FORWARDER</b> en ${S.brand} con esos números de PT / Sales Order.`
      );
    }

    const totalUnits = matchingRows.reduce((a, r) => a + Number(r['Cantidad'] || 0), 0);
    const matchedPtsCount = new Set(matchingRows.map(r => normalizePtId(r['Delivery']))).size;

    const ch = await modal(
      `Asignar Embarque a FORWARDER · ${S.brand}`,
      `<div class="space-y-3 text-slate-700">
         <p>Se encontraron <b>${fn(matchingRows.length)} líneas</b> (<b>${fn(totalUnits)} unidades</b>) en <b>FORWARDER</b> correspondientes a <b>${fn(matchedPtsCount)} PTs</b> del archivo de COMEX.</p>
         <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
           <div>
             <label class="block text-xs font-semibold text-slate-700 mb-1">Nombre del Embarque</label>
             <input type="text" id="inpPtsOnlyEmb" class="border rounded px-2.5 py-1.5 text-sm w-full bg-white font-semibold" value="${esc(defaultEmbName)}">
           </div>
           <div>
             <label class="block text-xs font-semibold text-slate-700 mb-1">Fecha de ingreso embarque</label>
             <input type="date" id="inpPtsOnlyFecha" class="border rounded px-2.5 py-1.5 text-sm w-full bg-white">
           </div>
         </div>
       </div>`,
      [['Cancelar', 'c'], ['Asignar Embarque', 'ok', 1]]
    );
    if (ch !== 'ok') return;

    const finalEmbOverride = $('inpPtsOnlyEmb') ? $('inpPtsOnlyEmb').value.trim() : '';
    const finalFecha = $('inpPtsOnlyFecha') ? $('inpPtsOnlyFecha').value.trim() : '';
    const affectedSeasons = new Set();

    matchingRows.forEach(r => {
      const ptVal = normalizePtId(r['Delivery']);
      r['EMBARQUE'] = finalEmbOverride || ptsMap.get(ptVal) || r['EMBARQUE'];
      if (finalFecha) r['Fecha de ingreso embarque'] = finalFecha;
      affectedSeasons.add(r.season || S.season);
    });

    if (S.lastBillingPreview && S.lastBillingPreview.brand === S.brand) {
      S.lastBillingPreview.rows.forEach(pr => {
        const ptVal = normalizePtId(pr.ptKey);
        if (ptVal && ptsMap.has(ptVal)) {
          pr.embarque = finalEmbOverride || ptsMap.get(ptVal);
          pr.isForwarder = false;
        }
      });
    }

    busy('Actualizando embarque en base local…');
    await tick();
    await dbPut(matchingRows);
    await reload();
    busy();

    if (S.cloud.dirHandle && S.cloud.autoSync && S.cloud.connected) {
      for (const sName of affectedSeasons) {
        await pushCloudBuySeason(S.brand, sName, true);
      }
    }

    modal('Embarque Asignado', `Se actualizaron <b>${fn(totalUnits)} unidades</b> de <b>FORWARDER</b> al embarque <b>${esc(finalEmbOverride || defaultEmbName)}</b>.`);
  } catch (e) {
    busy();
    modal('Error al asignar PTs', esc(e.message || e));
  }
}

