          <button type="button" id="btnCorpScopeBrand" class="px-3 py-1.5 rounded ${S.corp.scope === 'brand' ? 'bg-white text-slate-900 shadow-sm font-semibold' : 'text-slate-600 hover:text-slate-900'}">Consolidado ${esc(S.brand)}</button>
        </div>
        <select id="selCorpYear" class="border rounded-md px-3 py-1.5 text-sm font-semibold bg-white text-slate-800">
