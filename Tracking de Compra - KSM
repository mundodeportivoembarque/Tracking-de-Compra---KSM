                : `<span class="px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-900 border border-emerald-300 font-bold text-[11px]">${disp}</span>`)
            : disp;
          return `<td class="px-2.5 py-1.5 whitespace-nowrap border-r border-slate-100 ${isNum ? 'num' : ''} ${idx === codIdx ? 'sticky left-0 bg-white font-bold text-slate-900 shadow-[1px_0_0_#e2e8f0]' : ''}">${embBadge}</td>`;
        }).join('')}
      </tr>`;
    }).join('') || `<tr><td colspan="${headers.length}" class="p-8 text-center text-slate-400">No se encontraron líneas que coincidan con el filtro.</td></tr>`;

    $('billPrevPageInfo').textContent = `Página ${prevPage} de ${totalPages}`;
    $('billPrevBtnPrev').disabled = prevPage <= 1;
    $('billPrevBtnNext').disabled = prevPage >= totalPages;
  };

  $('billPrevSearch').oninput = () => { prevPage = 1; renderPrevRows(); };
  $('billPrevStatusFilter').onchange = () => { prevPage = 1; renderPrevRows(); };
  $('billPrevBtnPrev').onclick = () => { if (prevPage > 1) { prevPage--; renderPrevRows(); } };
  $('billPrevBtnNext').onclick = () => { prevPage++; renderPrevRows(); };
  $('btnExportBillPrevXlsx').onclick = () => exportBillingPreviewExcel(previewObj);
  $('btnCloseBillPrev').onclick = () => m.classList.add('hidden');

  renderPrevRows();
}

/* ============ MOTOR UNIFICADO DE FACTURACIÓN (ADIDAS Y REEBOK) ============ */
async function processBrandBilling(file, ptsFile = null) {
  const isReebok = String(S.brand).toUpperCase().includes('REEBOK');
  try {
    busy(`Procesando Detalle de Facturación ${S.brand}, PTs COMEX, Tallas SAP y Plantilla…`);
    await tick();

    const ptsMap = ptsFile ? await parsePtsExcelMap(ptsFile) : new Map();
    const ptsEmbarques = [...new Set(ptsMap.values())];
    const defaultPtsEmb = ptsEmbarques[0] || '';

    const wb = XLSX.read(await file.arrayBuffer(), { type: 'array', cellDates: true });
    // Para Reebok priorizar hoja que empiece con OC o la segunda hoja si existe TD primero
    let targetSheet = wb.SheetNames[0];
    if (isReebok) {
      targetSheet = wb.SheetNames.find(n => norm(n).startsWith('oc') || norm(n).includes('factura')) || (wb.SheetNames.length > 1 ? wb.SheetNames[1] : wb.SheetNames[0]);
    } else {
      targetSheet = wb.Sheets['Sheet1'] ? 'Sheet1' : (wb.Sheets['Hoja1'] ? 'Hoja1' : wb.SheetNames[0]);
    }
    const raw = XLSX.utils.sheet_to_json(wb.Sheets[targetSheet], { defval: '', raw: true });
    if (!raw.length) throw new Error('No se encontraron filas en el archivo de facturación.');

    const sizeLookup = buildTallaSapLookup();
    const allBrandRows = await getAllBrandRows(S.brand);

    const existingP24Invoices = new Set();
    allBrandRows.forEach(r => {
      if (st(r) === 'p' && r['Factura']) {
        existingP24Invoices.add(norm(r['Factura']));
      }
    });

    const tplBySeason = {};
    const globalTplItems = {};
    for (const [k, entry] of Object.entries(S.templates || {})) {
      const [bName, sName] = k.split('|');
      if (bName !== S.brand) continue;
      const items = entry && entry.items ? entry.items : (entry || {});
      tplBySeason[norm(sName)] = items;
      Object.assign(globalTplItems, items);
    }

    // Indexar filas 10A disponibles por Temporada+Código y Código
    const rows10ABySeasonCod = new Map();
    const rows10AByCod = new Map();
    allBrandRows.forEach(r => {
      if (st(r) === 'o' && Number(r['Cantidad'] || 0) > 0) {
        const temp = norm(r.season || r['Temporada']);
        const cod = norm(r['Código']);
        const scKey = `${temp}|${cod}`;
        if (!rows10ABySeasonCod.has(scKey)) rows10ABySeasonCod.set(scKey, []);
        rows10ABySeasonCod.get(scKey).push(r);
        if (!rows10AByCod.has(cod)) rows10AByCod.set(cod, []);
        rows10AByCod.get(cod).push(r);
      }
    });

    const parseNum = v => Number(String(v ?? '').replace(/[^0-9.,-]/g, '').replace(',', '.')) || 0;

    // 1. Parsear líneas crudas y agrupar bultos idénticos
    const groupedMap = new Map();
    const fileInvoices = new Set();
    const duplicateInvoicesFound = new Set();
    const ptsInEmb = new Set();
    const ptsForwarder = new Set();
    let unitsInEmb = 0;
    let unitsForwarder = 0;
    let detectedInvoiceDateInFile = '';

    for (const o of raw) {
      const materialRaw = isReebok
        ? String(getRowVal(o, ['NEW Material', 'New Material', 'Material', 'Código', 'Codigo']) ?? '').trim()
        : String(getRowVal(o, ['Material', 'Código', 'Codigo', 'SAP']) ?? '').trim();
      const codNorm = norm(materialRaw);
      const qty = isReebok
        ? parseNum(getRowVal(o, ['Final Delivery QTY TOTAL', 'Final Delivery QTY', 'Reques quantity', 'Cantidad', 'QTY']))
        : parseNum(getRowVal(o, ['Delivery quantity', 'Delivery Quantity', 'Invoiced Quantity', 'Cantidad', 'QTY']));
      if (!codNorm || qty <= 0) continue;

      const invNum = isReebok
        ? String(getRowVal(o, ['No FACTURA ', 'No FACTURA', 'No Factura', 'Invoice Number', 'Factura']) ?? '').trim()
        : String(getRowVal(o, ['Invoice Number', 'Factura', 'No FACTURA']) ?? '').trim();
      const invCodeRbk = isReebok ? String(getRowVal(o, ['FACTURA ', 'FACTURA']) ?? '').trim() : '';
      const invDate = fdate(getRowVal(o, ['Invoice Date', 'Fecha de factura', 'Additional Date', 'Requested deliv.date']));
      if (invDate && !detectedInvoiceDateInFile) detectedInvoiceDateInFile = invDate;

      // En Adidas el PT es Delivery; en Reebok el PT es Sales Order 1
      const ptRaw = isReebok
        ? normalizePtId(getRowVal(o, ['Sales Order 1', 'Sales Order', 'PT', 'Delivery']))
        : normalizePtId(getRowVal(o, ['Delivery', 'PT', 'Entrega']));

      const poRaw = isReebok
        ? String(getRowVal(o, ['Purchase No', 'Purchase order no.', 'Temporada']) ?? '').trim()
        : String(getRowVal(o, ['Purchase order no. (35 char)', 'Purchase order no.', 'Purchase Order', 'PO']) ?? '').trim();

      const gridVal = String(getRowVal(o, ['Grid Value', 'Talla marca', 'Talla Marca']) ?? '').trim();
      const explicitSap = String(getRowVal(o, ['TALLA SAP', 'Talla SAP']) ?? '').trim();

      const grossPrice = parseNum(getRowVal(o, ['Gross Price']));
      const netWithoutRound = parseNum(getRowVal(o, ['Net Without Round']));
      const netValWithoutRound = parseNum(getRowVal(o, ['Net value (without Round)']));
      const netPrice = isReebok
        ? parseNum(getRowVal(o, ['Net price Round', 'Net Price', 'Net Without Round', 'FOB']))
        : parseNum(getRowVal(o, ['Net price', 'Net Price', 'FOB', 'FOB MARCA']));
      const netValRaw = isReebok
        ? parseNum(getRowVal(o, ['Net value Round (DN)', 'Net value', 'Valor Neto']))
        : parseNum(getRowVal(o, ['Net value (DN)', 'Net value', 'Valor Neto']));

      // Cruce contra PTs COMEX -> Embarque vs FORWARDER
      let resolvedEmbarque = 'FORWARDER';
      let isForwarder = true;
      if (ptRaw && ptsMap.has(ptRaw)) {
        resolvedEmbarque = ptsMap.get(ptRaw);
        isForwarder = false;
      } else {
        const embColInFile = String(getRowVal(o, ['EMBARQUE', 'Embarque']) ?? '').trim();
        if (embColInFile && embColInFile.toUpperCase() !== 'FORWARDER') {
          resolvedEmbarque = embColInFile;
          isForwarder = false;
        }
      }

      if (isForwarder) {
        unitsForwarder += qty;
        if (ptRaw) ptsForwarder.add(ptRaw);
      } else {
        unitsInEmb += qty;
        if (ptRaw) ptsInEmb.add(ptRaw);
      }

      if (invNum) {
        fileInvoices.add(invNum);
        if (existingP24Invoices.has(norm(invNum))) {
          duplicateInvoicesFound.add(invNum);
        }
      }

      const seasonDet = extractSeasonFromPO(poRaw, S.season);

      // Resolver Talla SAP con desambiguación contra el saldo 10A del Material
      const candidates = getTallaSapCandidates(gridVal, explicitSap, sizeLookup);
      const poolForSku = rows10ABySeasonCod.get(`${norm(seasonDet)}|${codNorm}`) || rows10AByCod.get(codNorm) || [];
      let chosenTallaSap = candidates[0] || gridVal;
      if (candidates.length > 1 && poolForSku.length) {
        const matchIn10A = candidates.find(cand =>
          poolForSku.some(r => normTalla(r['Talla']) === normTalla(cand) || normTalla(r['Talla marca']) === normTalla(cand))
        );
        if (matchIn10A) chosenTallaSap = matchIn10A;
      }

      // Canal Inicial:
      // - En Adidas: desde Purchase order no.
      // - En Reebok: se deja vacío aquí para traerlo directamente desde la Compra Inicial 10A cruzada (o si ya viene en columna CANAL)
      const explicitCanalCol = String(getRowVal(o, ['CANAL INICIAL', 'Canal Inicial', 'CANAL']) ?? '').trim();
      const canalIniRaw = isReebok
        ? explicitCanalCol
        : (explicitCanalCol || resolveCanalInicialFromPO(poRaw));
      const canalUnif = canalIniRaw ? resolverCanalUnificado(canalIniRaw) : '';
      const compraExtraFlag = String(getRowVal(o, ['COMPRA EXTRA', 'DETALLE DE COMPRA']) ?? '').trim();

      // Enriquecer desde Plantilla de Presentación (Actividad, Grupo, Categoría, Género, Línea)
      const seasonTpl = tplBySeason[norm(seasonDet)] || globalTplItems;
      const tplItem = seasonTpl ? seasonTpl[codNorm] : null;

      const actividad = (tplItem && tplItem.actividad) ? tplItem.actividad : String(getRowVal(o, ['ACTIVIDAD', 'Sport Description']) ?? '').trim();
      const grupo = (tplItem && tplItem.grupo) ? tplItem.grupo : String(getRowVal(o, ['GRUPO', 'Product Type Description']) ?? '').trim();
      const categoria = (tplItem && tplItem.categoria) ? tplItem.categoria : String(getRowVal(o, ['CATEGORÍA', 'CATEGORIA', 'Division']) ?? '').trim();
      const genero = (tplItem && tplItem.genero) ? tplItem.genero : String(getRowVal(o, ['GÉNERO', 'GENERO', 'Gender']) ?? '').trim();
      const linea = (tplItem && tplItem.linea) ? tplItem.linea : String(getRowVal(o, ['LINEA', 'Línea', 'Product line']) ?? '').trim();
      const descripcion = (tplItem && tplItem.descripcion) ? tplItem.descripcion : String(getRowVal(o, ['Material Description', 'Descripción']) ?? '').trim();
      const color = (tplItem && tplItem.color) ? tplItem.color : String(getRowVal(o, ['Color']) ?? '').trim();

      const groupKey = `${invNum}|${ptRaw}|${poRaw}|${codNorm}|${normTalla(chosenTallaSap)}|${resolvedEmbarque}`;
      if (!groupedMap.has(groupKey)) {
        groupedMap.set(groupKey, {
          status: String(getRowVal(o, ['Status']) ?? 'NEW').trim(),
          soldToParty: String(getRowVal(o, ['Sold-to party']) ?? 'C101-000001').trim(),
          soldToName: String(getRowVal(o, ['Sold-to Name', 'Ship To Name']) ?? 'MUNDO DEPORTIVO MEDEPORT S A').trim(),
          salesDocType: String(getRowVal(o, ['Sales Document Type']) ?? '').trim(),
          invoiceDate: invDate,
          invoiceNumber: invNum,
          invCodeRbk,
          ptKey: ptRaw,
          poNumber: poRaw,
          canalInicial: canalIniRaw,
          canalUnificado: canalUnif,
          material: materialRaw,
          codNorm,
          ean: String(getRowVal(o, ['EAN VERIFICADO', 'EAN', 'EAN/UPC']) ?? '').trim(),
          upc: String(getRowVal(o, ['UPC']) ?? '').trim(),
          gridValue: gridVal,
          reqQty: 0,
          qty: 0,
          grossPrice,
          netWithoutRound,
          netValWithoutRound: 0,
          netPrice,
          netValue: 0,
          brandCode: String(getRowVal(o, ['Brand code']) ?? (isReebok ? 'RBK' : 'adidas')).trim(),
          salesDocOrder: String(getRowVal(o, ['Sales Document', 'Sales Document(ORDER NUMBER)', 'Sales Order 1']) ?? '').trim(),
          tallaSap: chosenTallaSap,
          candidates,
          idConcat: `${materialRaw} ${chosenTallaSap}`.trim(),
          actividad,
          grupo,
          embarque: resolvedEmbarque,
          isForwarder,
          categoria,
          genero,
          temporada: seasonDet,
          linea,
          compraExtra: compraExtraFlag,
          descripcion,
          color
        });
      }
      const g = groupedMap.get(groupKey);
      g.reqQty += parseNum(getRowVal(o, ['Reques quantity'])) || qty;
      g.qty += qty;
      if (netPrice > 0) g.netPrice = netPrice;
      g.netValue = Math.round((g.netPrice * g.qty) * 10000) / 10000 || (g.netValue + netValRaw);
      g.netValWithoutRound = Math.round((g.netWithoutRound * g.qty) * 10000) / 10000 || (g.netValWithoutRound + netValWithoutRound);
    }

    const consolidatedLines = [...groupedMap.values()];
    if (!consolidatedLines.length) {
      throw new Error('No se encontraron líneas facturadas válidas con Material y Cantidad > 0.');
    }

    // 2. Ejecutar simulación de descuento contra 10A
    // En Reebok: prioridad a coincidencia exacta de cantidad (ID + talla + cantidad) para resolver el canal inicial exacto,
    // y si vienen desagregadas (ej. 4 filas de 1 unid vs 1 fila de 4 unid), descuenta igualmente del saldo disponible y hereda su Canal Inicial!
    const changed = new Set();
    const added = [];
    const appliedP24Rows = [];
    let matchedUnits = 0;
    let totalFileUnits = 0;
    const perSeasonUnits = {};
    const unmatched = [];

    for (const line of consolidatedLines) {
      totalFileUnits += line.qty;
      const tempNorm = norm(line.temporada);
      const codNorm = line.codNorm;
      const candTallasNorm = line.candidates.map(normTalla).filter(Boolean);
      const targetCanalNorm = norm(line.canalInicial);
      const targetUnifNorm = norm(line.canalUnificado);
      const wantExtra = norm(line.compraExtra) === 'si' || norm(line.compraExtra) === 'compraextra' || norm(line.compraExtra) === 'x';

      const allSkuRows = [
        ...(rows10ABySeasonCod.get(`${tempNorm}|${codNorm}`) || []),
        ...(rows10AByCod.get(codNorm) || [])
      ].filter((v, idx, arr) => arr.indexOf(v) === idx && st(v) === 'o' && Number(v['Cantidad'] || 0) > 0);

      const scoreRow = r => {
        let sc = 0;
        if (norm(r.season || r['Temporada']) === tempNorm) sc += 100;
        const rTal = normTalla(r['Talla']);
        const rTalM = normTalla(r['Talla marca']);
        if (candTallasNorm.includes(rTal)) sc += 50;
        else if (candTallasNorm.includes(rTalM)) sc += 40;
        else return -1;

        if (targetCanalNorm) {
          const rCan = norm(r['Canal Inicial'] || resolverCanalInicial(r['Referencia compra'], S.brand));
          const rCanUnif = norm(resolverCanalUnificado(r['Canal Inicial'] || r['Referencia compra']));
          if (rCan && rCan === targetCanalNorm) sc += 25;
          else if (rCanUnif && rCanUnif === targetUnifNorm) sc += 12;
        } else if (isReebok) {
          // En Reebok sin canal explícito: si existe una fila en 10A con la MISMA cantidad exacta (tu regla ID+Talla+Cantidad), darle prioridad
          if (Math.abs(Number(r['Cantidad']) - line.qty) < 0.001) sc += 20;
        }

        const isExtraRow = norm(r['Detalle compra']) === 'compraextra';
        if (wantExtra === isExtraRow) sc += 5;
        return sc;
      };

      const pool = allSkuRows
        .map(r => ({ r, sc: scoreRow(r) }))
        .filter(x => x.sc >= 0)
        .sort((a, b) => b.sc - a.sc)
        .map(x => x.r);

      if (!pool.length) {
        unmatched.push({
          inv: line.invoiceNumber,
          pt: line.ptKey,
          temp: line.temporada,
          cod: line.material,
          grid: line.gridValue,
          sap: line.tallaSap,
          qty: line.qty
        });
        continue;
      }

      let rem = line.qty;
      const inheritedCanals = new Set();

      for (let i = 0; i < pool.length && rem > 0; i++) {
        const baseRow = pool[i];
        if (Number(baseRow['Cantidad'] || 0) <= 0 || st(baseRow) !== 'o') continue;
        const rowSeason = baseRow.season || S.season;
        const take = Math.min(Number(baseRow['Cantidad']), rem);

        const rowCanalIni = String(baseRow['Canal Inicial'] || resolverCanalInicial(baseRow['Referencia compra'], S.brand) || '').trim();
        if (rowCanalIni) inheritedCanals.add(rowCanalIni);

        const applyBillingFields = targetRow => {
          targetRow['Etapa'] = EP;
          if (line.invoiceNumber) targetRow['Factura'] = line.invoiceNumber;
          if (line.ptKey) targetRow['Delivery'] = line.ptKey;
          if (line.invoiceDate) targetRow['Fecha de factura'] = line.invoiceDate;
          targetRow['EMBARQUE'] = line.embarque;
          if (line.tallaSap) targetRow['Talla'] = line.tallaSap;
          if (line.gridValue) targetRow['Talla marca'] = line.gridValue;
          if (!targetRow['Canal Inicial']) {
            targetRow['Canal Inicial'] = line.canalInicial || rowCanalIni;
          }
          if (line.actividad) targetRow['Actividad'] = line.actividad;
          if (line.grupo) targetRow['Grupo'] = line.grupo;
          if (line.categoria) targetRow['Categoría'] = line.categoria;
          if (line.genero) targetRow['Género'] = line.genero;
          if (line.linea) targetRow['Línea'] = line.linea;
          if (line.descripcion && !targetRow['Descripción']) targetRow['Descripción'] = line.descripcion;
          if (line.netPrice > 0) targetRow['FOB'] = line.netPrice;
          targetRow['Valor Neto'] = calcValorNeto(targetRow);
          appliedP24Rows.push({ row: targetRow, isForwarder: line.isForwarder });
        };

        if (Number(baseRow['Cantidad']) <= rem) {
          rem -= take;
          matchedUnits += take;
          perSeasonUnits[rowSeason] = (perSeasonUnits[rowSeason] || 0) + take;
          applyBillingFields(baseRow);
          changed.add(baseRow);
        } else {
          const facturada = { ...baseRow };
          delete facturada.id;
          facturada['Cantidad'] = take;
          applyBillingFields(facturada);

          baseRow['Cantidad'] = Number(baseRow['Cantidad']) - take;
          baseRow['Valor Neto'] = calcValorNeto(baseRow);

          matchedUnits += take;
          perSeasonUnits[rowSeason] = (perSeasonUnits[rowSeason] || 0) + take;
          rem = 0;
          changed.add(baseRow);
          added.push(facturada);
        }
      }

      // En Reebok: completar CANAL INICIAL y CANAL UNIFICADO en el Excel maestro transformado a partir de la compra inicial cruzada
      if (!line.canalInicial && inheritedCanals.size > 0) {
        const resolvedIni = [...inheritedCanals].join(' / ');
        line.canalInicial = resolvedIni;
        const unifs = [...new Set([...inheritedCanals].map(resolverCanalUnificado).filter(Boolean))];
        line.canalUnificado = unifs.join(' / ');
      }

      if (rem > 0) {
        unmatched.push({
          inv: line.invoiceNumber,
          pt: line.ptKey,
          temp: line.temporada,
          cod: line.material,
          grid: line.gridValue,
          sap: line.tallaSap,
          qty: rem
        });
      }
    }

    // Construir objeto de Vista Previa con las columnas exactas según la marca
    const buildPreviewSnapshot = () => {
      if (isReebok) {
        const headers = [
          'Status', 'Sold-to party', 'Sales Order 1', 'No FACTURA ', 'FACTURA ', 'Purchase No',
          'CANAL INICIAL', 'CANAL UNIFICADO', 'NEW Material', 'Grid Value', 'Reques quantity',
          'Final Delivery QTY TOTAL', 'Gross Price', 'Net Without Round', 'Net value (without Round)',
          'Net price Round', 'Net value Round (DN)', 'EAN VERIFICADO', 'UPC', 'TALLA SAP',
          'ID (NEW MATERIAL + "ESPACIO EN BLANCO" + TALLA SAP', 'MAR SAP NUEVO', 'EAN SAP',
          'ACTIVIDAD', 'GRUPO', 'EMBARQUE', 'CATEGORÍA', 'GÉNERO', 'TEMPORADA', 'LINEA', 'DETALLE DE COMPRA'
        ];
        return {
          brand: S.brand,
          headers,
          codIdx: 8,
          embIdx: 25,
          factIdx: 3,
          ptIdx: 2,
          rows: consolidatedLines.map(r => ({
            isForwarder: r.isForwarder,
            embarque: r.embarque,
            ptKey: r.ptKey,
            cells: [
              r.status, r.soldToParty, r.ptKey, r.invoiceNumber, r.invCodeRbk, r.poNumber,
              r.canalInicial, r.canalUnificado, r.material, r.gridValue, r.reqQty,
              r.qty, r.grossPrice, r.netWithoutRound, r.netValWithoutRound,
              r.netPrice, r.netValue, r.ean, r.upc, r.tallaSap,
              r.idConcat, '', '',
              r.actividad, r.grupo, r.embarque, r.categoria, r.genero, r.temporada, r.linea, r.compraExtra
            ]
          }))
        };
      } else {
        const headers = [
          'Sold-to Name', 'Invoice Date', 'Sales Document Type', 'Invoice Number', 'Delivery',
          'Purchase order no.', 'CANAL INICIAL', 'CANAL UNIFICADO', 'Material', 'EAN',
          'Grid Value', 'Delivery Quantity', 'Net Price', 'Net value', 'Brand code',
          'Sales Document(ORDER NUMBER)', 'TALLA SAP', 'ID (material + "espacio en blanco" + talla sap")',
          'MAR SAP NUEVO', 'EAN SAP', 'ACTIVIDAD', 'GRUPO', 'EMBARQUE',
          'CATEGORÍA', 'GÉNERO', 'TEMPORADA', 'LINEA', 'COMPRA EXTRA'
        ];
        return {
          brand: S.brand,
          headers,
          codIdx: 8,
          embIdx: 22,
          factIdx: 3,
          ptIdx: 4,
          rows: consolidatedLines.map(r => ({
            isForwarder: r.isForwarder,
            embarque: r.embarque,
            ptKey: r.ptKey,
            cells: [
              r.soldToName, r.invoiceDate, r.salesDocType, r.invoiceNumber, r.ptKey,
              r.poNumber, r.canalInicial, r.canalUnificado, r.material, r.ean,
              r.gridValue, r.qty, r.netPrice, r.netValue, r.brandCode,
              r.salesDocOrder, r.tallaSap, r.idConcat,
              '', '', r.actividad, r.grupo, r.embarque,
              r.categoria, r.genero, r.temporada, r.linea, r.compraExtra
            ]
          }))
        };
      }
    };

    S.lastBillingPreview = buildPreviewSnapshot();
    busy();

    const breakdown = Object.entries(perSeasonUnits)
      .map(([sName, u]) => `<span class="inline-block bg-slate-100 border px-2 py-0.5 rounded text-xs font-semibold mr-1.5">${esc(sName)}: ${fn(u)} unid.</span>`)
      .join('');

    const ptsSummaryHtml = ptsMap.size > 0
      ? `<div class="p-3 rounded-lg bg-sky-50 border border-sky-200 text-sky-950 text-xs space-y-1">
           <div class="font-bold text-sky-900">Cruce de PTs COMEX (${fn(ptsMap.size)} PTs en listado):</div>
           <div>🚢 <b>En Embarque (${esc(ptsEmbarques.join(', '))}):</b> ${fn(unitsInEmb)} unid. (${fn(ptsInEmb.size)} PTs cruzados)</div>
           <div>📦 <b>En FORWARDER (PTs fuera de lista):</b> ${fn(unitsForwarder)} unid. (${fn(ptsForwarder.size)} PTs quedan en <code>FORWARDER</code>)</div>
         </div>`
      : `<div class="p-2.5 rounded-lg bg-amber-50 border border-amber-300 text-amber-900 text-xs">
