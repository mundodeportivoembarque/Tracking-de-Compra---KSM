function calcValorNeto(r) {
  const fob = Number(r['FOB'] || 0);
  const qty = Number(r['Cantidad'] || 0);
  return Math.round(fob * qty * 10000) / 10000;
}

function hasPriceChange(r) {
  const pvpIni = Number(r['PVP'] || 0);
  const pvpFin = Number(r['PVP Final'] || 0);
  return pvpFin > 0 && Math.abs(pvpIni - pvpFin) > 0.001;
}

function fdate(v) {
  if (!v && v !== 0) return '';
  if (v instanceof Date && !isNaN(v)) {
    return v.getFullYear() + '-' + String(v.getMonth() + 1).padStart(2, '0') + '-' + String(v.getDate()).padStart(2, '0');
  }
  if (typeof v === 'number' && v > 20000 && v < 80000) {
    const dt = new Date(Math.round((v - 25569) * 86400 * 1000));
    if (!isNaN(dt)) return dt.getUTCFullYear() + '-' + String(dt.getUTCMonth() + 1).padStart(2, '0') + '-' + String(dt.getUTCDate()).padStart(2, '0');
  }
  const s = String(v).trim();
  if (/^\d{1,2}\/\d{1,2}\/\d{2,4}$/.test(s)) {
    const [d, m, yRaw] = s.split('/');
    const y = yRaw.length === 2 ? '20' + yRaw : yRaw;
    return `${y}-${m.padStart(2, '0')}-${d.padStart(2, '0')}`;
  }
  return s;
}
function getQuincena(fechaStr) {
  const s = String(fechaStr || '').trim();
  if (!s) return '';
  let day = 0;
  if (/^\d{4}-\d{1,2}-\d{1,2}/.test(s)) {
    day = parseInt(s.split('-')[2], 10);
  } else if (/^\d{1,2}\/\d{1,2}\/\d{2,4}/.test(s)) {
    day = parseInt(s.split('/')[0], 10);
  }
  if (!day || isNaN(day)) return '';
  return day <= 15 ? 'q1' : 'q2';
}
