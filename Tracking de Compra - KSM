  let fobT = 0, fobP = 0, fobO = 0, fobD = 0;
  let canalUnits = 0, extraUnits = 0, canalFob = 0, extraFob = 0;
  let priceAlerts = 0, priceAlertUnits = 0;

  for (const r of S.rows) {
