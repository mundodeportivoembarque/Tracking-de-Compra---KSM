async function revertOcsByKeys(selectedKeys) {
  busy('Revirtiendo OCs y consolidando saldos 10A…');
  await tick();
  const pool10A = new Map();
  S.rows.forEach(r => {
    if (st(r) === 'o') {
      const k = `${norm(r['Código'])}|${norm(r['Color'])}|${normTalla(r['Talla'])}|${norm(r['Referencia compra'])}|${norm(r['Seguimiento'])}|${norm(r['Detalle compra'])}`;
      if (!pool10A.has(k)) pool10A.set(k, r);
    }
  });
  const toUpdate = new Set();
  const toDeleteIds = [];
  let revertedUnits = 0;
  for (const r of S.rows) {
    if (st(r) !== 'p') continue;
    const fact = String(r['Factura'] || '').trim() || 'SIN FACTURA';
    const emb = String(r['EMBARQUE'] || '').trim() || 'SIN EMBARQUE';
    const key = `${fact}|||${emb}`;
    if (!selectedKeys.has(key)) continue;
    const qty = Number(r['Cantidad'] || 0);
    revertedUnits += qty;
    const mergeKey = `${norm(r['Código'])}|${norm(r['Color'])}|${normTalla(r['Talla'])}|${norm(r['Referencia compra'])}|${norm(r['Seguimiento'])}|${norm(r['Detalle compra'])}`;
    const existing10A = pool10A.get(mergeKey);
    if (existing10A && existing10A.id !== r.id) {
      existing10A['Cantidad'] = (Number(existing10A['Cantidad']) || 0) + qty;
      existing10A['Valor Neto'] = calcValorNeto(existing10A);
      toUpdate.add(existing10A);
      if (r.id != null) toDeleteIds.push(r.id);
    } else {
      r['Etapa'] = E10;
      r['Factura'] = '';
      r['Fecha de factura'] = '';
      r['EMBARQUE'] = '';
      r['Fecha de ingreso embarque'] = '';
      r['Canal Final'] = '';
      r['PVP Final'] = 0;
      r['P4 Final'] = 0;
      r['PMY Final'] = 0;
      r['Valor Neto'] = calcValorNeto(r);
      toUpdate.add(r);
      pool10A.set(mergeKey, r);
    }
  }
  if (toUpdate.size) await dbPut([...toUpdate]);
  if (toDeleteIds.length) await dbDeleteIds(toDeleteIds);
  await reload();
  busy();
      if (S.cloud.dirHandle && S.cloud.autoSync && S.cloud.connected) {
      pushCloudBuySeason(S.brand, S.season, true);
    }
    modal('OCs Revertidas', `Se devolvieron <b>${fn(revertedUnits)} unidades</b> a estado disponible <b>10A</b> y se recalcularon los valores netos.`);
}
