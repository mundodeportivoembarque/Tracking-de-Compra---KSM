              ? `<span class="ml-1 inline-flex items-center px-1.5 py-0.2 rounded text-[10px] font-bold ${pvpFin > pvpIni ? 'bg-amber-100 text-amber-800 border border-amber-300' : 'bg-sky-100 text-sky-800 border border-sky-300'}" title="PVP cambió de ${pvpIni.toFixed(2)} a ${pvpFin.toFixed(2)}">${pvpFin > pvpIni ? '▲' : '▼'}</span>`
              : '';
            const detBadge = r['Detalle compra'] === 'COMPRA EXTRA'
              ? 'bg-teal-50 text-teal-800 border-teal-200'
              : 'bg-slate-100 text-slate-700 border-slate-200';
            return `
            <tr class="r-${st(r)} border-t border-white/60">
              <td class="px-3 py-1.5">${esc(r['Seguimiento'])}</td>
              <td class="px-3 py-1.5 whitespace-nowrap"><span class="text-[11px] font-semibold px-2 py-0.5 rounded border ${detBadge}">${esc(r['Detalle compra'] || 'COMPRA CANAL')}</span></td>
              <td class="px-3 py-1.5 font-medium">${esc(r['Código'])}</td>
              <td class="px-3 py-1.5 max-w-[14rem] truncate" title="${esc(r['Descripción'])}">${esc(r['Descripción'])}</td>
              <td class="px-3 py-1.5">${esc(r['Color'])}</td>
              <td class="px-3 py-1.5">${esc(r['Talla'])}</td>
              <td class="px-3 py-1.5 whitespace-nowrap">${esc(String(r['Etapa']).split('-')[0])}</td>
              <td class="px-3 py-1.5 text-xs text-slate-500">${esc(r['Referencia compra'])}</td>
              <td class="px-3 py-1.5 font-medium">${esc(r['Canal Inicial'] || '')}</td>
              <td class="px-3 py-1.5 font-semibold text-indigo-900">${esc(r['Canal Final'] || '')}</td>
              <td class="px-3 py-1.5 num font-semibold">${fn(r['Cantidad'])}</td>
              <td class="px-3 py-1.5 num text-slate-600">${Number(r['FOB'] || 0).toFixed(2)}</td>
              <td class="px-3 py-1.5 num font-semibold text-slate-800">${fmoney(r['Valor Neto'] || calcValorNeto(r))}</td>
              <td class="px-3 py-1.5 num">${pvpIni.toFixed(2)}</td>
              <td class="px-3 py-1.5 num font-semibold whitespace-nowrap ${pChanged ? 'text-amber-800 bg-amber-100/70' : 'text-emerald-800'}">${pvpFin ? pvpFin.toFixed(2) : '-'}${badgePrecio}</td>
              <td class="px-3 py-1.5 font-medium">${esc(r['Factura'])}</td>
              <td class="px-3 py-1.5 whitespace-nowrap text-xs text-slate-600">${esc(r['Fecha de factura'] || '')}</td>
              <td class="px-3 py-1.5 font-semibold text-slate-700 whitespace-nowrap">${esc(r['EMBARQUE'] || '')}</td>
              <td class="px-3 py-1.5 whitespace-nowrap text-xs font-medium text-sky-900">${esc(r['Fecha de ingreso embarque'] || '')}</td>
            </tr>
          `}).join('') || '<tr><td colspan="19" class="p-6 text-center text-slate-500">Sin resultados para estos filtros.</td></tr>'}
        </tbody>
        ${rows.length ? `
        <tfoot>
          <tr class="font-semibold text-slate-800 text-sm">
            <td colspan="10" class="px-3 py-2.5 text-right text-xs uppercase tracking-wider text-slate-500">Totales filtrados:</td>
            <td class="px-3 py-2.5 num font-bold text-slate-900 text-base">${fn(totalCantidad)}</td>
            <td class="px-3 py-2.5"></td>
            <td class="px-3 py-2.5 num font-bold text-indigo-950 text-base">${fmoney(totalValorNeto)}</td>
            <td colspan="6" class="px-3 py-2.5"></td>
          </tr>
        </tfoot>` : ''}
      </table>
    </div>
    ${pager(rows.length)}
  `;
}
function pager(n) {
  const pages = Math.max(1, Math.ceil(n / S.size));
  S.page = Math.min(S.page, pages);
  return `
    <div class="flex items-center gap-2 text-sm mt-3">
      <span class="text-slate-600">${fn(n)} filas</span>
      <span class="ml-auto"></span>
      <select class="border rounded px-2 py-1 bg-white" onchange="S.size=+this.value;S.page=1;drawMx()">
        ${[50, 100, 200].map(x => `<option ${x === S.size ? 'selected' : ''}>${x}</option>`).join('')}
      </select>
      <button class="btn" ${S.page < 2 ? 'disabled' : ''} onclick="S.page--;drawMx()">Anterior</button>
      <span>${S.page} / ${pages}</span>
      <button class="btn" ${S.page >= pages ? 'disabled' : ''} onclick="S.page++;drawMx()">Siguiente</button>
    </div>
  `;
}
