function getTplData(key = sbKey()) {
  const raw = S.templates[key];
  if (!raw) return { headers: [], items: {} };
  if (raw.items && Array.isArray(raw.headers)) return raw;
  return {
    headers: ['Código', 'Descripción', 'Grupo', 'Categoría', 'Actividad', 'Línea', 'Género', 'Color', 'FOB', 'PVP', 'PVP retail', 'P4', 'PMY', 'Fecha de entrega', 'Fecha de venta'],
    items: raw
  };
}
function isRowLockedByEmbarque(r) {
  return Boolean(String(r['EMBARQUE'] || '').trim());
}

function applyTemplateToRow(r, tplCatalog) {
  const itemsMap = tplCatalog && tplCatalog.items ? tplCatalog.items : tplCatalog;
  if (!itemsMap || isRowLockedByEmbarque(r)) return false;
  const cod = norm(r['Código']);
  if (!cod) return false;
  const item = itemsMap[cod];
  if (!item) return false;

  let changed = false;
  if (item.descripcion && r['Descripción'] !== item.descripcion) { r['Descripción'] = item.descripcion; changed = true; }
  if (item.grupo && r['Grupo'] !== item.grupo) { r['Grupo'] = item.grupo; changed = true; }
  if (item.categoria && r['Categoría'] !== item.categoria) { r['Categoría'] = item.categoria; changed = true; }
  if (item.actividad && r['Actividad'] !== item.actividad) { r['Actividad'] = item.actividad; changed = true; }
  if (item.linea && r['Línea'] !== item.linea) { r['Línea'] = item.linea; changed = true; }
  if (item.genero && r['Género'] !== item.genero) { r['Género'] = item.genero; changed = true; }
  if (item.color && (!r['Color'] || norm(r['Color']) === 'faltacolor')) { r['Color'] = item.color; changed = true; }
  if (item.fEntrega && r['Fecha de entrega'] !== item.fEntrega) { r['Fecha de entrega'] = item.fEntrega; changed = true; }
  if (item.fVenta && r['Fecha de venta'] !== item.fVenta) { r['Fecha de venta'] = item.fVenta; changed = true; }

  if (item.fob > 0 && Math.abs((Number(r['FOB']) || 0) - item.fob) > 0.0001) {
    r['FOB'] = item.fob;
    changed = true;
  }
  if (item.pvp > 0 && Math.abs((Number(r['PVP']) || 0) - item.pvp) > 0.001) {
    r['PVP'] = item.pvp;
    changed = true;
  }
  if (item.pvpRetail > 0 && Math.abs((Number(r['PVP retail']) || 0) - item.pvpRetail) > 0.001) {
    r['PVP retail'] = item.pvpRetail;
    changed = true;
  }
  if (item.p4 > 0 && Math.abs((Number(r['P4']) || 0) - item.p4) > 0.001) {
    r['P4'] = item.p4;
    changed = true;
  }
  if (item.pmy > 0 && Math.abs((Number(r['PMY']) || 0) - item.pmy) > 0.001) {
    r['PMY'] = item.pmy;
    changed = true;
  }
  const newVn = calcValorNeto(r);
  if (Math.abs((Number(r['Valor Neto']) || 0) - newVn) > 0.0001) {
    r['Valor Neto'] = newVn;
    changed = true;
  }
  return changed;
}

