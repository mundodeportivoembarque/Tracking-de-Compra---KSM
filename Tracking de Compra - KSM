(async () => {
  try {
    if (navigator.storage && navigator.storage.persist) {
      navigator.storage.persist().catch(() => {});
    }
    db = await openDB();
    const m = await rq(db.transaction('meta').objectStore('meta').get('seasons'));
    if (m) S.seasons = m;
    const savedLogos = await rq(db.transaction('meta').objectStore('meta').get('logos'));
    if (savedLogos) S.logos = savedLogos;
    const savedTemplates = await rq(db.transaction('meta').objectStore('meta').get('templates'));
    if (savedTemplates) S.templates = savedTemplates;
    const savedSizePairs = await rq(db.transaction('meta').objectStore('meta').get('sizePairs'));
    if (Array.isArray(savedSizePairs)) S.sizePairs = savedSizePairs;
    const act = await rq(db.transaction('meta').objectStore('meta').get('active'));
    if (act && act.brand && act.season) {
      S.brand = act.brand;
      S.season = act.season;
    }
    await loadSavedCloudHandle();
    if (S.cloud.dirHandle && S.cloud.connected && S.cloud.autoSync) {
      await pullFromCloudFolder(false, true);
    } else {
      await reload();
    }
    updateCloudBadge();
  } catch(e) {
    document.body.innerHTML = '<p class="p-8">Error iniciando IndexedDB: ' + esc(e.message) + '</p>';
  }
})();
