async function loadSizeMapExcel(file) {
  try {
    busy('Procesando maestro de Tallas SAP…');
    await tick();
    const wb = XLSX.read(await file.arrayBuffer(), { type: 'array', raw: true });
    const sheet = wb.Sheets[wb.SheetNames[0]];
    const raw = XLSX.utils.sheet_to_json(sheet, { defval: '', raw: true });
    if (!raw.length) throw new Error('El archivo de tallas está vacío.');

    const incoming = [];
    for (const o of raw) {
      const tm = String(getRowVal(o, ['TALLA MARCA', 'Talla Marca', 'Grid Value']) ?? '').trim();
      const ts = String(getRowVal(o, ['TALLA SAP', 'Talla SAP']) ?? '').trim();
      if (tm && ts) incoming.push([tm, ts]);
    }
    if (!incoming.length) throw new Error('No se encontraron columnas "TALLA MARCA" y "TALLA SAP" válidas.');

    const base = (sizeUploadMode === 'merge' && Array.isArray(S.sizePairs)) ? [...S.sizePairs] : [];
    const seen = new Set(base.map(p => `${String(p[0]).trim().toUpperCase()}|||${String(p[1]).trim().toUpperCase()}`));
    let addedCount = 0;
    for (const [tm, ts] of incoming) {
      const k = `${tm.toUpperCase()}|||${ts.toUpperCase()}`;
      if (!seen.has(k)) {
        seen.add(k);
        base.push([tm, ts]);
        addedCount++;
      }
    }

    S.sizePairs = base;
    await saveMeta();
    renderMain();
    busy();
    if (S.cloud.dirHandle && S.cloud.autoSync && S.cloud.connected) {
      pushCloudConfig();
    }
    modal(
      'Maestro de Tallas SAP Actualizado',
      `Se procesaron <b>${fn(incoming.length)} filas</b> del archivo (${sizeUploadMode === 'merge' ? `<b>${fn(addedCount)} nuevas</b> anexadas` : 'reemplazo total'}).<br>
       Total activo compartido para Adidas y Reebok: <b>${fn(S.sizePairs.length)} equivalencias</b>.`
    );
  } catch (e) {
    busy();
    modal('Error al procesar Tallas SAP', esc(e.message || e));
  }
}

