/* ============ PARSER DE PTS COMEX Y CRUCE DE FACTURACIÓN (ADIDAS Y REEBOK) ============ */
function normalizePtId(val) {
  if (val === null || val === undefined) return '';
  let s = String(val).trim();
  if (!s) return '';
  if (/^\d+\.0+$/.test(s)) s = s.replace(/\.0+$/, '');
  return s.toUpperCase();
}

async function parsePtsExcelMap(file) {
  const wb = XLSX.read(await file.arrayBuffer(), { type: 'array', raw: true });
  const sheet = wb.Sheets[wb.SheetNames[0]];
  const aoa = XLSX.utils.sheet_to_json(sheet, { header: 1, defval: '', raw: true });
  const ptsMap = new Map();
  if (!aoa.length) return ptsMap;

  let startRow = 0;
  let ptCol = 0;
  let embCol = 1;
  const r0 = aoa[0].map(c => norm(c));
  const foundPtCol = r0.findIndex(h => h.startsWith('pts') || h.includes('delivery') || h.includes('salesorder') || h === 'pt' || h === 'entrega');
  const foundEmbCol = r0.findIndex(h => h.includes('embarque') || h.includes('shipment'));
  if (foundPtCol !== -1 || foundEmbCol !== -1 || isNaN(Number(String(aoa[0][0] || '').trim()))) {
    startRow = 1;
    if (foundPtCol !== -1) ptCol = foundPtCol;
    if (foundEmbCol !== -1) embCol = foundEmbCol;
  }

  for (let i = startRow; i < aoa.length; i++) {
    const row = aoa[i];
    if (!row || !row.length) continue;
    const pt = normalizePtId(row[ptCol]);
    const emb = String(row[embCol] ?? '').trim();
    if (pt && /^\d{5,}$/.test(pt)) {
      ptsMap.set(pt, emb || 'EMBARQUE ASIGNADO');
    }
  }
  return ptsMap;
}

