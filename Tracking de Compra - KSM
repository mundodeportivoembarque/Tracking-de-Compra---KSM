         <i data-lucide="info" class="w-4 h-4 text-sky-700 shrink-0"></i>
         <span>Hay <b>${fn(p24WithoutIngresoDate)} unidades</b> en P24 de OCs anteriores que aún no tienen la columna <b>"Fecha de ingreso embarque"</b>; el sistema las ubicó usando su <b>Fecha de factura / entrega</b> como respaldo.</span>
       </div>`
    : '';

  view.innerHTML = `
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4 bg-white p-4 rounded-lg border">
      <div>
        <h2 class="text-base font-bold text-slate-900">Resumen Corporativo de Ingresos por Mes · ${esc(scopeLabel)}</h2>
