// Guarda SOLO el archivo de Compra de la temporada indicada (ej. Compra_Adidas_FW26.json.gz)
async function pushCloudBuySeason(brand = S.brand, season = S.season, silent = true) {
  if (!S.cloud.dirHandle) return false;
  const okPerm = await ensureCloudPermission(!silent);
  if (!okPerm) return false;

  try {
    if (!silent) busy(`Guardando ${buyFileName(brand, season)} en OneDrive…`);
    await tick();
    const key = `${brand}|${season}`;
    const seasonRows = (brand === S.brand && season === S.season) ? S.rows : await dbSeason(key);
    const cleanRows = seasonRows.map(r => {
      const o = { ...r };
      delete o.id;
      return o;
    });
    const payload = {
      app: 'EOT_MEDEPORT_BUY',
      version: '7.1',
      brand,
      season,
      updatedAt: new Date().toISOString(),
      rowCount: cleanRows.length,
      rows: cleanRows
    };
    const buf = await compressJsonString(JSON.stringify(payload));
    const fname = buyFileName(brand, season);
    await writeCloudFile(fname, buf);
    await pushCloudConfig();

    const nowStr = new Date().toLocaleTimeString('es-EC', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    S.cloud.lastSync = nowStr;
    S.cloud.filesStatus[fname] = { rows: cleanRows.length, kb: Math.round(buf.byteLength / 1024), time: nowStr };
    await saveCloudDirHandle(S.cloud.dirHandle, S.cloud.autoSync);
    if (!silent) busy();
    return true;
  } catch (e) {
    if (!silent) {
      busy();
      modal('Error al guardar Compra en OneDrive', esc(e.message || e));
    }
    return false;
  }
}

// Guarda SOLO el archivo de Plantilla de Presentación de la temporada indicada (ej. Plantilla_Adidas_FW26.json.gz)
