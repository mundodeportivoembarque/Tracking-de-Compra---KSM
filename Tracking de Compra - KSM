const getRowVal = (o, keys) => {
  for (const k of keys) {
    if (o[k] !== undefined && o[k] !== '') return o[k];
  }
  const normKeys = keys.map(k => norm(k));
  for (const origKey of Object.keys(o)) {
    if (normKeys.includes(norm(origKey)) && o[origKey] !== undefined && o[origKey] !== '') {
      return o[origKey];
    }
  }
  return '';
};
function mergePools(...lists) {
  const seen = new Set();
  const res = [];
  for (const lst of lists) {
    if (!lst) continue;
    for (const item of lst) {
      if (!seen.has(item)) {
        seen.add(item);
        res.push(item);
      }
    }
  }
  return res;
}
